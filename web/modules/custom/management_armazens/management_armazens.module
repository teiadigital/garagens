function management_armazens_validate_area_partilhada(&$entity_form, &$form_state) {
  $altura_i = (float) ($form_state->getValues()['field_area_individual'][0]['inline_entity_form']['field_altura'][0]['value'] ?? 0);
  $comp_i   = (float) ($form_state->getValues()['field_area_individual'][0]['inline_entity_form']['field_comprimento'][0]['value'] ?? 0);
  $larg_i   = (float) ($form_state->getValues()['field_area_individual'][0]['inline_entity_form']['field_largura'][0]['value'] ?? 0);

  if (($form_state->getValues()['field_permite_ser_partilhado'][0]['value'] ?? '') === 'sim') {
    $comp = (float) ($entity_form['field_comprimento']['widget'][0]['value']['#value'] ?? 0);
    $larg = (float) ($entity_form['field_largura']['widget'][0]['value']['#value'] ?? 0);
    $alt  = (float) ($entity_form['field_altura']['widget'][0]['value']['#value'] ?? 0);

    if ($comp > $comp_i) {
      $form_state->setError($entity_form, t('The length of the shared area cannot be greater than the length of the total area.'));
    }
    if ($larg > $larg_i) {
      $form_state->setError($entity_form, t('The width of the shared area cannot be greater than the width of the total area.'));
    }
    if ($alt  > $altura_i) {
      $form_state->setError($entity_form, t('The height of the shared area cannot be greater than the height of the total area.'));
    }
  }
}

function management_armazens_validate_raques(&$entity_form, &$form_state) {
  $comp = (float) ($entity_form['field_comprimento']['widget'][0]['value']['#value'] ?? 0);
  $larg = (float) ($entity_form['field_largura']['widget'][0]['value']['#value'] ?? 0);
  $alt  = (float) ($entity_form['field_altura']['widget'][0]['value']['#value'] ?? 0);

  $alt_i  = (float) ($form_state->getValues()['field_area_individual'][0]['inline_entity_form']['field_altura'][0]['value'] ?? 0);
  $comp_i = (float) ($form_state->getValues()['field_area_individual'][0]['inline_entity_form']['field_comprimento'][0]['value'] ?? 0);
  $larg_i = (float) ($form_state->getValues()['field_area_individual'][0]['inline_entity_form']['field_largura'][0]['value'] ?? 0);

  if ($comp > $comp_i) {
    $form_state->setError($entity_form, t('The length of the racks must not be greater than the length of the total area.'));
  }
  if ($larg > $larg_i) {
    $form_state->setError($entity_form, t('The width of the racks must not be greater than the width of the total area.'));
  }
  if ($alt  > $alt_i) {
    $form_state->setError($entity_form, t('The height of the racks must not be greater than the height of the total area.'));
  }
}

function management_armazens_preprocess_links(&$variables) {
  $variables['current_language'] = \Drupal::languageManager()->getCurrentLanguage()->getId();
}

/**
 * Liga os validadores dos IEF somente quando o wrapper existir no passo.
 */
function _ma_attach_ief_validators(array &$form): void {
  if (isset($form['field_preco_full'])) {
    $form['field_preco_full']['#element_validate'][] = 'management_armazens_validate_prices_aluguer_do_imovel';
  }
  if (isset($form['field_preco_partilhado'])) {
    $form['field_preco_partilhado']['#element_validate'][] = 'management_armazens_validate_prices_aluguer_por_area';
  }
  if (isset($form['field_preco_temp'])) {
    $form['field_preco_temp']['#element_validate'][] = 'management_armazens_validate_prices_aluguer_camara_de_frio';
  }
  if (isset($form['field_euro_paletes'])) {
    $form['field_euro_paletes']['#element_validate'][] = 'management_armazens_validate_prices_aluguer_euro_paletes';
  }
  if (isset($form['field_paletes_americanas'])) {
    $form['field_paletes_americanas']['#element_validate'][] = 'management_armazens_validate_prices_aluguer_paletes_ameri';
  }
  if (isset($form['field_area_partilhada'])) {
    $form['field_area_partilhada']['#element_validate'][] = 'management_armazens_validate_area_partilhada';
  }
  if (isset($form['field_raques'])) {
    $form['field_raques']['#element_validate'][] = 'management_armazens_validate_raques';
  }
}

function management_armazens_validate_postal_code(array &$form, FormStateInterface $form_state): void {
  // Garante que temos o array do address.
  $address = $form_state->getValue(['field_localidade', 0, 'address']);
  if (!is_array($address)) {
    return;
  }

  $postal_code  = trim($address['postal_code'] ?? '');
  $country_code = strtoupper(trim($address['country_code'] ?? ''));

  if ($postal_code === '' || $country_code === '') {
    return;
  }

  // 1) Validar FORMATO usando os padrões do Address module (por país).
  /** @var \CommerceGuys\Addressing\AddressFormat\AddressFormatRepositoryInterface $repo */
  $repo = \Drupal::service('address.address_format_repository');
  $format = $repo->get($country_code);
  $pattern = $format ? $format->getPostalCodePattern() : null;

  if ($pattern) {
    // O padrão vem sem delimitadores; ancoramos e usamos /u.
    $regex = '/^' . $pattern . '$/u';
    if (!preg_match($regex, $postal_code)) {
      // Usa setError associado ao elemento, se possível.
      if (isset($form['field_localidade']['widget'][0]['address']['postal_code'])) {
        $form_state->setError(
          $form['field_localidade']['widget'][0]['address']['postal_code'],
          t('Formato de código-postal inválido para @country.', ['@country' => $country_code])
        );
      } else {
        // Fallback pelo "name".
        $form_state->setErrorByName('field_localidade][0][address][postal_code', t('Formato de código-postal inválido.'));
      }
      return;
    }
  }
  // Se não houver pattern para o país, não bloqueamos pelo formato.

  // 2) (Opcional) Validar EXISTÊNCIA via GeoNames. Não bloquear em falha.
  try {
    $client = \Drupal::httpClient();
    $res = $client->get('http://api.geonames.org/postalCodeLookupJSON', [
      'query' => [
        'postalcode' => $postal_code,
        'country'    => $country_code,
        'username'   => 'teiadigital',
      ],
      'timeout' => 5,
    ]);
    $json = json_decode((string) $res->getBody(), true);
    if (empty($json['postalcodes'])) {
      if (isset($form['field_localidade']['widget'][0]['address']['postal_code'])) {
        $form_state->setError(
          $form['field_localidade']['widget'][0]['address']['postal_code'],
          t('O código-postal não foi encontrado.')
        );
      } else {
        $form_state->setErrorByName('field_localidade][0][address][postal_code', t('O código-postal não foi encontrado.'));
      }
    }
  } catch (\Exception $e) {
    // Não bloquear o wizard se a API falhar.
    return;
  }
}

function management_armazens_module_implements_alter(array &$implementations, $hook) {
  if ($hook === 'form_alter' || $hook === 'form_node_form_alter') {
    if (isset($implementations['management_armazens'])) {
      $ours = $implementations['management_armazens'];
      unset($implementations['management_armazens']);
      $implementations['management_armazens'] = $ours;
    }
  }
}


/**
 * Validação custom: obriga o utilizador a escolher opção diferente de "-- Selecionar --".
 */
function management_armazens_form_validate($form, FormStateInterface $form_state) {
  if ($form_state->getValue('field_espaco') === '_none') {
    $form_state->setErrorByName('field_espaco', t('Por favor, selecione uma opção válida.'));
  }
  if ($form_state->getValue('field_limitacoes_carga_descarga') === '_none') {
    $form_state->setErrorByName('field_limitacoes_carga_descarga', t('Por favor, selecione uma opção válida.'));
  }
  if ($form_state->getValue('field_carga_adr') === '_none') {
    $form_state->setErrorByName('field_carga_adr', t('Por favor, selecione uma opção válida.'));
  }
}