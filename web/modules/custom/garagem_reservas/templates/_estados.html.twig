{#
/**
 * @file
 * Macros partilhadas de estado para reservas.
 *
 * Uso:
 *   {% import '@garagem_reservas/_estados.html.twig' as estados %}
 *   {{ estados.pill(reserva.estado, tipo) }}
 *   {{ estados.topo(reserva.estado) }}
 */
#}

{# ── Pill descritiva (lista de reservas) ──────────────────────────────────── #}
{% macro pill(estado, tipo) %}
  {% if estado == 'pago' %}
    <span class="inline-flex items-center gap-1.5 text-xs font-semibold px-2.5 py-1 rounded-lg"
          style="background:#f0fdf4; color:#15803d; border:1px solid #bbf7d0">
      <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
      </svg>
      {{ 'Pagamento confirmado'|t }}
    </span>

  {% elseif estado == 'aprovado' and tipo != 'proprietario' %}
    <span class="inline-flex items-center gap-1.5 text-xs font-semibold px-2.5 py-1 rounded-lg"
          style="background:#eff6ff; color:#1d4ed8; border:1px solid #bfdbfe">
      <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
      </svg>
      {{ 'Aprovada — procede ao pagamento'|t }}
    </span>

  {% elseif estado == 'aprovado' %}
    <span class="inline-flex items-center gap-1.5 text-xs font-semibold px-2.5 py-1 rounded-lg"
          style="background:#eff6ff; color:#1d4ed8; border:1px solid #bfdbfe">
      <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
      </svg>
      {{ 'Reserva aprovada'|t }}
    </span>

  {% elseif estado == 'pendente' and tipo == 'proprietario' %}
    <span class="inline-flex items-center gap-1.5 text-xs font-semibold px-2.5 py-1 rounded-lg"
          style="background:#fffbeb; color:#92400e; border:1px solid #fde68a">
      <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/>
      </svg>
      {{ 'Aguarda a tua aprovação'|t }}
    </span>

  {% elseif estado == 'pendente' %}
    <span class="inline-flex items-center gap-1.5 text-xs font-semibold px-2.5 py-1 rounded-lg"
          style="background:#fffbeb; color:#92400e; border:1px solid #fde68a">
      <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/>
      </svg>
      {{ 'Aguarda aprovação do proprietário'|t }}
    </span>

  {% elseif estado == 'aguarda_pagamento' %}
    <span class="inline-flex items-center gap-1.5 text-xs font-semibold px-2.5 py-1 rounded-lg"
          style="background:#fff7ed; color:#9a3412; border:1px solid #fed7aa">
      <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/>
      </svg>
      {{ 'Pagamento pendente'|t }}
    </span>

  {% elseif estado == 'cancelado' %}
    <span class="inline-flex items-center gap-1.5 text-xs font-semibold px-2.5 py-1 rounded-lg"
          style="background:#f9fafb; color:#374151; border:1px solid #e5e7eb">
      <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
      </svg>
      {{ 'Reserva cancelada'|t }}
    </span>

  {% elseif estado == 'rejeitado' %}
    <span class="inline-flex items-center gap-1.5 text-xs font-semibold px-2.5 py-1 rounded-lg"
          style="background:#fef2f2; color:#991b1b; border:1px solid #fecaca">
      <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
      </svg>
      {{ 'Reserva rejeitada'|t }}
    </span>

  {% elseif estado == 'expirado' %}
    <span class="inline-flex items-center gap-1.5 text-xs font-semibold px-2.5 py-1 rounded-lg"
          style="background:#f9fafb; color:#6b7280; border:1px solid #e5e7eb">
      <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
      </svg>
      {{ 'Esta reserva expirou'|t }}
    </span>
  {% endif %}
{% endmacro %}


{# ── Pill encomenda (estados Commerce) ────────────────────────────────────── #}
{% macro pill_encomenda(estado) %}
  {% if estado == 'completed' %}
    <span class="inline-flex items-center gap-1.5 text-xs font-semibold px-2.5 py-1 rounded-lg"
          style="background:#f0fdf4; color:#15803d; border:1px solid #bbf7d0">
      <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
      </svg>
      {{ 'Pagamento confirmado'|t }}
    </span>

  {% elseif estado == 'pending' %}
    <span class="inline-flex items-center gap-1.5 text-xs font-semibold px-2.5 py-1 rounded-lg"
          style="background:#fffbeb; color:#92400e; border:1px solid #fde68a">
      <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/>
      </svg>
      {{ 'Pagamento pendente'|t }}
    </span>

  {% elseif estado == 'fulfillment' %}
    <span class="inline-flex items-center gap-1.5 text-xs font-semibold px-2.5 py-1 rounded-lg"
          style="background:#eff6ff; color:#1d4ed8; border:1px solid #bfdbfe">
      <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
      </svg>
      {{ 'Em processamento'|t }}
    </span>

  {% elseif estado == 'cancelled' %}
    <span class="inline-flex items-center gap-1.5 text-xs font-semibold px-2.5 py-1 rounded-lg"
          style="background:#fef2f2; color:#991b1b; border:1px solid #fecaca">
      <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
      </svg>
      {{ 'Encomenda cancelada'|t }}
    </span>

  {% else %}
    <span class="inline-flex items-center gap-1.5 text-xs font-semibold px-2.5 py-1 rounded-lg"
          style="background:#f9fafb; color:#6b7280; border:1px solid #e5e7eb">
      <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
      </svg>
      {{ 'Rascunho'|t }}
    </span>
  {% endif %}
{% endmacro %}


{# ── Badge topo (página de detalhe) ───────────────────────────────────────── #}
{% macro topo(estado) %}
  {% set cfg = {
    'pendente':          { bg: 'bg-yellow-100', color: 'text-yellow-700', label: 'Pendente' },
    'aprovado':          { bg: 'bg-blue-100',   color: 'text-blue-700',   label: 'Aprovado' },
    'aguarda_pagamento': { bg: 'bg-orange-100', color: 'text-orange-700', label: 'Aguarda pagamento' },
    'pago':              { bg: 'bg-green-100',  color: 'text-green-700',  label: 'Pago' },
    'rejeitado':         { bg: 'bg-red-100',    color: 'text-red-600',    label: 'Rejeitado' },
    'cancelado':         { bg: 'bg-gray-100',   color: 'text-gray-500',   label: 'Cancelado' },
    'expirado':          { bg: 'bg-gray-100',   color: 'text-gray-400',   label: 'Expirado' },
  } %}
  {% set c = cfg[estado] %}
  {% if c %}
    <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wide {{ c.bg }} {{ c.color }}">
      {{ c.label|t }}
    </span>
  {% endif %}
{% endmacro %}
