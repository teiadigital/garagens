{#
/**
 * @file
 * Cards de garagens no perfil — idêntico à pesquisa.
 */
#}
{{ attach_library('garagem_pesquisa/cards') }}

{% if rows %}
  <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 lg:gap-6" style="align-items:start;">
    {% for key, row in rows %}
      {% set url        = view.style_plugin.getField(key, 'view_node')|render|striptags|spaceless %}
      {% set estado     = view.style_plugin.getField(key, 'field_estado')|render|striptags|spaceless %}
      {% set titulo     = view.style_plugin.getField(key, 'title')|render|striptags|spaceless %}
      {% set localidade = view.style_plugin.getField(key, 'field_localidade')|render|striptags|spaceless %}

      {% if estado == '-1' %}
        {% set badge_label = 'Não acabado'|t %}
        {% set badge_class = 'bg-gray-700 text-white' %}
      {% elseif estado == '0' %}
        {% set badge_label = 'Aguardar aprovação'|t %}
        {% set badge_class = 'bg-blue-600 text-white' %}
      {% elseif estado == '1' %}
        {% set badge_label = 'Com erros'|t %}
        {% set badge_class = 'bg-yellow-500 text-white' %}
      {% elseif estado == '2' %}
        {% set badge_label = 'Não aprovado'|t %}
        {% set badge_class = 'bg-red-600 text-white' %}
      {% elseif estado == '3' %}
        {% set badge_label = 'Aprovado'|t %}
        {% set badge_class = 'bg-green-600 text-white' %}
      {% else %}
        {% set badge_label = null %}
      {% endif %}

      <a href="{{ url }}" class="garagem-card">
        <div class="garagem-card-img">
          {{ view.style_plugin.getField(key, 'field_fotos') }}
          {% if badge_label %}
            <span class="absolute top-2.5 left-2.5 {{ badge_class }} text-xs font-semibold px-2.5 py-1 rounded-full z-10">
              {{ badge_label }}
            </span>
          {% endif %}
        </div>
        <div class="card-info">
          <div class="card-info-top">
            <p class="card-titulo">{{ titulo }}</p>
          </div>
          <p class="card-localidade">{{ localidade }}</p>
        </div>
      </a>
    {% endfor %}
  </div>
{% else %}
  <div class="text-center py-16 text-gray-400">
    <p class="text-sm">{{ 'Ainda não tens garagens.'|t }}</p>
  </div>
{% endif %}
