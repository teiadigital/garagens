/**
 * Implements hook_form_alter().
 */
function bws_form_alter(&$form, FormStateInterface $form_state, $form_id) {

  if ($form_id == 'node_type_edit_form' || $form_id == 'node_type_add_form') {
    if (\Drupal::currentUser()->hasPermission('administer bws settings')) {
      $node_type = $form_state->getFormObject()->getEntity();
      assert($node_type instanceof NodeType);

      $bws_settings = $node_type->getThirdPartySetting('bws', 'bws');

      $form['bws'] = [
        '#type' => 'details',
        '#title' => t('BWS'),
        '#group' => 'additional_settings',
        '#tree' => TRUE,
      ];
      $form['bws']['bookable'] = [
        '#type' => 'checkbox',
        '#title' => t('Make this entity type bookable'),
        '#default_value' => isset($bws_settings['bookable']) ? $bws_settings['bookable'] : 0,
      ];

      $form['bws']['payment'] = [
        '#type' => 'checkbox',
        '#title' => t('Enable payment for bookings'),
        '#default_value' => isset($bws_settings['payment']) ? $bws_settings['payment'] : 0,
        '#states' => [
          'visible' => [
            ':input[name="bws[bookable]"]' => ['checked' => TRUE],
          ],
        ],
      ];

      if (!(\Drupal::moduleHandler()->moduleExists('commerce_checkout') &&
            \Drupal::moduleHandler()->moduleExists('commerce_payment'))) {
        $form['bws']['payment']['#disabled'] = TRUE;
        $form['bws']['payment']['#description'] = t('To enable payments for bookings, install and enable the Drupal Commerce checkout and payment modules and configure a Commerce Store.');
      }
      elseif (\Drupal::moduleHandler()->moduleExists('commerce')) {
        if (empty(Store::loadMultiple())) {
          $form['bws']['payment']['#disabled'] = TRUE;
          $form['bws']['payment']['#description'] = t('To enable payments for bookings, install and enable the Drupal Commerce checkout and payment modules and configure a Commerce Store.');
        }
      }

      if (isset($bws_settings['type_id'])) {
        $form['bws']['type_id'] = [
          '#type' => 'hidden',
          '#value' => $bws_settings['type_id'],
        ];
      }

      $form['actions']['submit']['#submit'][] = 'bws_node_type_edit_form_submit';

      $form['#attached']['library'][] = 'bws/bws';
    }
  }

   
  if($form_id == "node_booking_armazens_step_3_form") {
   
    $form['actions']['submit']['#submit'][] = 'bws_node_insert_add_booking';
  }
}


function bws_node_insert_add_booking($node) {

  $node_type = NodeType::load($node->bundle());
  assert($node_type instanceof NodeType);
  $bws_settings = $node_type->getThirdPartySetting('bws', 'bws');

  if (isset($bws_settings['bookable']) && $bws_settings['bookable']) {

    $units_ids = $node->get('field_availability_' . $bws_settings['bookable_type'])->getValue();

    $units = get_units_in_armazem($node);

    if(!empty($units)) {
      foreach($units as $unit) {

        if($unit['unit_bundle'] == 'area_partilhada') {

          $bat_unit = bat_unit_create(
            [
              'name' => $unit['name'],
              'type' => $unit['unit_bundle'],
              'unit_type_id' => $bws_settings['type_id'],
              'field_comprimento' => $unit['comprimento'],
              'field_largura' => $unit['largura'],
              'field_area_total' => $unit['area_disponivel'],
              'field_area_disponivel' => $unit['area_disponivel'],
            ]
          );
        } else {
          
          $bat_unit = bat_unit_create(
            [
              'name' => $unit['name'],
              'type' => $unit['unit_bundle'],
              'unit_type_id' => $bws_settings['type_id'],
            ]
          );
        }
        
        

        bat_unit_save($bat_unit);

        $units_ids[]['target_id'] = $bat_unit->id();
      }

      $node->set('field_availability_' . $bws_settings['bookable_type'], $units_ids);
      // $node->changed_time = $form_state->getValue('changed');
      $node->setNewRevision(FALSE);
      $node->save();
    }
  }
}

function get_units_in_armazem($node) {

  $units = array();

  if($node->get('field_bool_aluguer_do_imovel')->getString() == "1") {
      $units[] = array(
          "tipo" => "aluguer_imovel",
          "unit_bundle" => "area_total",
          "name" => "Aluguer do Imóvel"
      );
  }

  if($node->get('field_bool_aluguer_por_area')->getString() == "1") {

    $field_area_partilhada = $node->get('field_area_partilhada')->getValue();

    foreach($field_area_partilhada as $area_partilhada) {

      $p = \Drupal\paragraphs\Entity\Paragraph::load( $area_partilhada['target_id'] );

      $comprimento = $p->get('field_comprimento')->getString();
      $largura = $p->get('field_largura')->getString();
    }

    $area_disponivel = floatval($comprimento) * floatval($largura);
    

    $units[] = array(
      "tipo" => "aluguer_parcial",
      "unit_bundle" => "area_partilhada",
      "name" => "Aluguer de espaço",
      "comprimento" => floatval($comprimento),
      "largura" => floatval($largura),
      "area_disponivel" => $area_disponivel
    );
  }

  if($node->get('field_bool_aluguer_camara_de_fri')->getString() == "1") {

    $camaras_frio = $node->get('field_camara_de_frio')->getValue();

    foreach($camaras_frio as $camara_frio) {
      
      $p = \Drupal\paragraphs\Entity\Paragraph::load( $camara_frio['target_id'] );

      $units[] = array(
        "tipo" => "aluguer_camaras_de_frio",
        "unit_bundle" => "camara_de_frio",
        "name" => t("Camara de frio") ." (". $p->get('field_capacidade')->getString() . " m³)"
      );

    }
  }

  return $units;
}


/**
 * Custom submit function for the node_type_edit_form and node_type_add_form.
 */
function bws_node_type_edit_form_submit(array &$form, FormStateInterface $form_state) {
  $node_type = $form_state->getFormObject()->getEntity();
  assert($node_type instanceof NodeType);

  $bws_settings = $form_state->getValue('bws');

  $bws_settings['bookable_type'] = "daily";
  $bws_settings['availability'] = "available";
  $bws_settings['payment_default_value'] = $form['bws']['payment']['#default_value'];

  bws_set_bws_to_node($node_type, $bws_settings);
  return;

}

/**
 * Implements hook_ENTITY_TYPE_presave().
 */
function bws_node_presave(EntityInterface $node) {
  if (isset($node->changed_time)) {
    $node->setChangedTime($node->changed_time);
  }
}

/**
 * Implements hook_ENTITY_TYPE_delete().
 */
function bws_node_delete(EntityInterface $node) {
  $node_type = NodeType::load($node->bundle());
  assert($node_type instanceof NodeType);
  $bws_settings = $node_type->getThirdPartySetting('bws', 'bws');

  if (!empty($bws_settings['bookable_type']) && $node->hasField('field_availability_' . $bws_settings['bookable_type'])) {
    if ($bat_unit = $node->get('field_availability_' . $bws_settings['bookable_type'])->entity) {
      bat_unit_delete($bat_unit);
    }

    if ($bws_settings['payment']) {
      if ($product = $node->get('field_product')->entity) {
        $product->delete();
      }
    }
  }
}

/**
 * Implements hook_ENTITY_TYPE_delete().
 */
function bws_commerce_order_item_delete(OrderItemInterface $order_item) {
  if ($order_item->bundle() == 'bws') {
    if ($booking = $order_item->get('field_booking')->entity) {
      $booking->delete();
    }
  }
}

/**
 * Implements hook_theme_registry_alter().
 */
function bws_theme_registry_alter(&$theme_registry) {

  $theme_registry['field__node__field_availability_daily'] = [
    'template' => 'field-availability-daily',
    'path' => \Drupal::service('extension.list.module')->getPath('bws') . '/templates',
    'render element' => 'element',
    'base hook' => 'field',
    'type' => 'module',
    'theme path' => \Drupal::service('extension.list.module')->getPath('bws'),
    'preprocess functions' => [
      'template_preprocess',
      'template_preprocess_field',
    ],
  ];
}

/**
 * Implements hook_entity_view_display_alter().
 */
function bws_entity_view_display_alter(EntityViewDisplayInterface $display, $context) {
  if ($context['entity_type'] == 'node') {
    if ($node = \Drupal::routeMatch()->getParameter('node')) {
      if ($display->getComponent('field_open_hours')) {
        if (!($node->get('field_use_open_hours')->value)) {
          $display->removeComponent('field_open_hours');
        }
      }
    }
  }
}

/**
 * Implements hook_entity_view_alter().
 */
function bws_entity_view_alter(array &$build, EntityInterface $entity, EntityViewDisplayInterface $display) {
  if ($entity->getEntityTypeId() == 'bat_unit') {

    if ($display->id() == 'bat_unit.default.daily_calendar' || $display->id() == 'bat_unit.area_total.daily_calendar' || $display->id() == 'bat_unit.area_partilhada.daily_calendar' || $display->id() == 'bat_unit.camara_de_frio.daily_calendar') {

      $bat_type = $entity->get('unit_type_id')->entity;

      $unit_type = $bat_type->id();

      $node = $build['#bat_unit']->_referringItem->getEntity();

      $units_ids = [];
      foreach ($node->get('field_availability_' . $bat_type->bundle()) as $unit) {
        if ($unit->entity) {
          $units_ids[] = $unit->entity->id();
        }
      }
      

      if ($bat_type->bundle() == 'daily') {
        $event_type = 'availability_daily';
        $event_granularity = 'bat_daily';

        $fc_user_settings = [
          'batCalendar' => [
            [
              'unitType' => $unit_type,
              'unitIds' => implode(',', $units_ids),
              'eventType' => $event_type,
              'eventGranularity' => $event_granularity,
              'editable' => FALSE,
              'selectable' => FALSE,
              'defaultView' => 'month',
              'views' => 'month',
              'headerLeft' => 'today',
              'headerCenter' => 'title',
              'headerRight' => 'prev, next',
              'resourceLabelText' => ' ',
            ],
          ],
        ];
      }
      
      $calendar_settings['user_settings'] = $fc_user_settings;
      $calendar_settings['calendar_id'] = 'fullcalendar-scheduler';

      $render_array = [
        'calendar' => [
          '#theme' => 'bat_fullcalendar',
          '#calendar_settings' => $calendar_settings,
          '#attached' => ['library' => ['bat_event_ui/bat_event_ui', 'bat_fullcalendar/bat-fullcalendar-scheduler']],
        ],
      ];

      $build = [
        '#markup' => \Drupal::service('renderer')->render($render_array),
      ];
    }
  }
}

/**
 * Implements hook_bat_api_events_index_calendar_alter().
 */
function bws_bat_api_events_index_calendar_alter(&$events, $context) {
  if ($context['background'] == 'hide-book') {
    foreach ($events as $id => $event) {
      if ($event['type'] == 'availability_daily') {
        unset($events[$id]['rendering']);

        if ($event['blocking']) {
          if ($event['type'] == 'availability_daily') {
            $state = bat_event_load_state_by_machine_name('bws_daily_not_available');
          }

          $events[$id]['color'] = $state->getColor();
          $events[$id]['title'] = $state->getCalendarLabel();
        }

        $start_date = new DateTime($event['start']);
        $end_date = new DateTime($event['end']);

        if ($start_date->format('Y-m-d') != $end_date->format('Y-m-d')) {
          $events[$id]['end'] = $end_date->add(new DateInterval('P1D'))->format('Y-m-d') . 'T00:00:00';
        }
      }
    }
  }
}

/**
 * Implements hook_views_pre_render().
 */
function bws_views_pre_render(ViewExecutable $view) {
  if ($view->id() == 'commerce_order_item_table') {
    foreach ($view->result as $id => $result) {
      if ($result->_entity->bundle() == 'bws') {
        if (($booking = $result->_entity->get('field_booking')->entity) &&
            ($node = $result->_entity->get('field_node')->entity)) {
          $url = Url::fromRoute('entity.node.canonical', ['node' => $node->id()]);
          $link = Link::fromTextAndUrl($node->label(), $url)->toString();

          $start_date = $booking->get('booking_start_date')->value;
          $end_date = $booking->get('booking_end_date')->value;

          $title = Markup::create('Booking for ' . $link . ' from ' . $start_date . ' to ' . $end_date);

          $view->result[$id]->_entity->set('title', $title);
        }
      }
    }
  }
}

function bws_mail($key, &$message, $params) {
 $options = array(
   'langcode' => $message['langcode'],
 );
 switch ($key) {
   case 'general_mail':
     $message['from'] = $params['headers']['From'] ?? NULL;
     $message['subject'] = isset($params['subject']) ? str_replace(["\r\n", "\r", "\n"], ' ', $params['subject']) : NULL;
    $message['body'][] = $params['body'];
     break;
 }
}

/**
 * Add "Availability" field to the node type.
 *
 * @param string $field_name
 * @param \Drupal\node\Entity\NodeType $node_type
 */
function bws_add_availability_field($field_name, NodeType $node_type) {
  $field_storage = FieldStorageConfig::loadByName('node', $field_name);
  $field = FieldConfig::loadByName('node', $node_type->id(), $field_name);

  if (empty($field_storage)) {
    $field_storage = FieldStorageConfig::create([
      'field_name' => $field_name,
      'entity_type' => 'node',
      'type' => 'entity_reference',
      'cardinality' => -1,
      'locked' => 1,
      'settings' => [
        'target_type' => 'bat_unit',
      ],
    ]);
    $field_storage->save();
  }

  if (empty($field)) {
    $field = FieldConfig::create([
      'field_storage' => $field_storage,
      'entity_type' => 'node',
      'label' => 'Availability',
      'bundle' => $node_type->id(),
      'required' => FALSE,
      'settings' => [
        'handler' => 'default',
        'handler_settings' => [],
      ],
    ]);
    $field->save();
  }
}

/**
 * Add "Open Hours" field to the node type.
 *
 * @param string $field_name
 * @param \Drupal\node\Entity\NodeType $node_type
 */
function bws_add_open_hours_field($field_name, NodeType $node_type) {
  $field_storage = FieldStorageConfig::loadByName('node', $field_name);
  $field = FieldConfig::loadByName('node', $node_type->id(), $field_name);

  if (empty($field_storage)) {
    $field_storage = FieldStorageConfig::create([
      'field_name' => $field_name,
      'entity_type' => 'node',
      'type' => 'office_hours',
      'cardinality' => -1,
      'locked' => 1,
      'settings' => [
        'cardinality_per_day' => 2,
        'time_format' => 'G',
        'element_type' => 'office_hours_datetime',
        'increment' => 60,
        'comment' => FALSE,
        'valhrs' => FALSE,
        'limit_start' => '',
        'limit_end' => '',
      ],
    ]);
    $field_storage->save();
  }

  if (empty($field)) {
    $field = FieldConfig::create([
      'field_storage' => $field_storage,
      'entity_type' => 'node',
      'label' => 'Open Hours',
      'bundle' => $node_type->id(),
      'required' => FALSE,
      'settings' => [
        'handler' => 'default',
        'handler_settings' => [],
      ],
    ]);
    $field->save();

    $form_display = \Drupal::entityTypeManager()->getStorage('entity_form_display')->load('node.' . $node_type->id() . '.default');
    if ($form_display !== NULL) {
      $form_display->setComponent($field_name, [
        'type' => 'office_hours_default',
        'weight' => 3,
      ]);
      $form_display->save();
    }

    $view_display = \Drupal::entityTypeManager()->getStorage('entity_view_display')->load('node.' . $node_type->id() . '.default');
    if ($view_display !== NULL) {
      $view_display->setComponent($field_name, [
        'type' => 'office_hours_table',
        'region' => 'content',
        'label' => 'above',
        'settings' => [],
      ]);
      $view_display->save();
    }
  }
}

