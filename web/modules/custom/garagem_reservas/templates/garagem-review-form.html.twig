{#
  Template para o formulário de avaliação de garagem.

  Variables:
  - form: O render array do formulário Drupal
  - garagem_foto: URL da foto da garagem (ou NULL)
  - garagem_titulo: Título da garagem
  - garagem_localidade: Localidade da garagem
  - data_inicio: Data de início formatada
  - data_fim: Data de fim formatada (ou "Renovação automática")
  - garagem_url: URL da página da garagem
#}

<div class="max-w-xl mx-auto">

  {# Card com info da garagem #}
  <div class="flex items-center gap-4 p-4 border border-gray-200 rounded-2xl mb-10">
    {% if garagem_foto %}
      <img src="{{ garagem_foto }}" alt="{{ garagem_titulo }}" class="w-20 h-20 rounded-xl object-cover flex-shrink-0">
    {% else %}
      <div class="w-20 h-20 rounded-xl bg-gray-100 flex items-center justify-center flex-shrink-0">
        <svg class="w-8 h-8 text-gray-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
        </svg>
      </div>
    {% endif %}
    <div class="min-w-0">
      <p class="font-semibold text-gray-900 text-sm leading-tight">{{ garagem_titulo }}</p>
      {% if garagem_localidade %}
        <p class="text-xs text-gray-400 mt-0.5">{{ garagem_localidade }}</p>
      {% endif %}
      <p class="text-xs text-gray-500 mt-2 font-medium">{{ data_inicio }} → {{ data_fim }}</p>
    </div>
  </div>

  {# Título do formulário #}
  <h1 class="text-2xl font-bold text-gray-900 mb-2">{{ 'Como foi a sua experiência?'|t }}</h1>
  <p class="text-sm text-gray-500 mb-8">{{ 'A sua opinião ajuda outros utilizadores a encontrar o espaço certo.'|t }}</p>

  {# Formulário Drupal #}
  {{ form }}

</div>
