{#
/**
 * @file
 * Perfil do gestor — mostra estatísticas e atalhos rápidos.
 */
#}
<article{{ attributes.addClass('profile') }}>

  <div class="mb-6">
    <h1 class="text-2xl font-bold text-gray-900">{{ 'Painel de gestão'|t }}</h1>
    <p class="text-sm text-gray-400 mt-1">{{ 'Bem-vindo, '|t }}{{ user.getDisplayName() }}</p>
  </div>

  {{ content.gestor_stats }}

</article>
