{#
/**
 * @file
 * Template de notificações.
 */
#}

{# Ícone por tipo de notificação #}
{% macro icone(bundle) %}
  {% if 'pago' in bundle or 'pagamento' in bundle %}
    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
    </svg>
  {% elseif 'cancelad' in bundle or 'cancel' in bundle %}
    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
    </svg>
  {% elseif 'rejeitad' in bundle or 'rejeitar' in bundle %}
    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"/>
    </svg>
  {% elseif 'aprovad' in bundle or 'aprovar' in bundle %}
    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
    </svg>
  {% elseif 'expirad' in bundle %}
    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
    </svg>
  {% else %}
    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/>
    </svg>
  {% endif %}
{% endmacro %}

{# Cor do ícone por tipo #}
{% macro cor_icone(bundle) %}
  {% if 'pago' in bundle or 'pagamento' in bundle %}text-green-600 bg-green-50
  {% elseif 'cancelad' in bundle or 'cancel' in bundle %}text-red-500 bg-red-50
  {% elseif 'rejeitad' in bundle or 'rejeitar' in bundle %}text-red-500 bg-red-50
  {% elseif 'aprovad' in bundle or 'aprovar' in bundle %}text-blue-600 bg-blue-50
  {% elseif 'expirad' in bundle %}text-amber-500 bg-amber-50
  {% else %}text-gray-500 bg-gray-100{% endif %}
{% endmacro %}

<div class="w-full">

  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold text-gray-900">{{ 'Notificações'|t }}</h1>
    {% if items is not empty %}
      <span class="text-xs text-gray-400">{{ items|length }} {{ 'notificações'|t }}</span>
    {% endif %}
  </div>

  {% if items is empty %}
    <div class="flex flex-col items-center justify-center py-16 text-center">
      <div class="w-14 h-14 rounded-full bg-gray-100 flex items-center justify-center mb-4">
        <svg class="w-6 h-6 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/>
        </svg>
      </div>
      <p class="text-sm font-medium text-gray-500">{{ 'Sem notificações'|t }}</p>
      <p class="text-xs text-gray-400 mt-1">{{ 'As suas notificações aparecerão aqui.'|t }}</p>
    </div>

  {% else %}
    <div class="space-y-2">
      {% for item in items %}
        {% set tag = item.url_reserva ? 'a' : 'div' %}
        <{{ tag }}
          {% if item.url_reserva %}href="{{ item.url_reserva }}"{% endif %}
          class="flex items-start gap-4 p-4 bg-white border border-gray-200 rounded-2xl hover:border-gray-300 hover:shadow-sm transition-all no-underline">

          {# Ícone #}
          <div class="w-9 h-9 rounded-full flex items-center justify-center flex-shrink-0 {{ _self.cor_icone(item.bundle) }}">
            {{ _self.icone(item.bundle) }}
          </div>

          {# Conteúdo #}
          <div class="flex-1 min-w-0">
            <div class="flex items-center justify-between gap-3 mb-1">
              <p class="text-xs font-semibold text-gray-500 uppercase tracking-widest truncate">{{ item.label }}</p>
              <span class="text-xs text-gray-400 flex-shrink-0">{{ item.created|date('d/m/Y H:i') }}</span>
            </div>
            {% if item.text %}
              <div class="text-sm text-gray-700 leading-relaxed">{{ item.text|raw }}</div>
            {% endif %}
          </div>

          {% if item.url_reserva %}
            <svg class="w-4 h-4 text-gray-300 flex-shrink-0 mt-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          {% endif %}

        </{{ tag }}>
      {% endfor %}
    </div>
  {% endif %}

</div>
