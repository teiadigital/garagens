+    /**
+   * Find the locality for a given country.
+   */
+  public function findConselho(string $country_code, string $state_code): array {
+    $countries = $this->getCountries();
+    $country = $countries[$country_code];
+
+    $states = $this->findSubDivision($country_code);
+    $state_codes = array_column($states, 'state_code');
+    $current_state_key = array_search($state_code, $state_codes);
+
+    if (isset($states[$current_state_key]['conselhos'])) {
+      
+      return $states[$current_state_key]['conselhos'];
+    }
+    else {
+      return [
+        [
+          'conselho_code' => $state_code,
+          'conselho' => 'No states associated with this country.',
+        ],
+      ];
+    }
+  }
+
