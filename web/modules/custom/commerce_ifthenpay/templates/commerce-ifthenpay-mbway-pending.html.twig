{#
/**
 * @file
 * Template para a página de espera do pagamento MB WAY.
 *
 * Variáveis:
 * - phone: Últimos dígitos do número de telemóvel
 * - amount: Valor a pagar
 * - expires_at: Timestamp de expiração (usado pelo JS)
 */
#}

<div class="ifthenpay-mbway" id="ifthenpay-mbway-waiting">

  {# Estado: aguardando (visível por defeito) #}
  <div class="ifthenpay-mbway__state" id="ifthenpay-mbway-state-pending">

    <div class="ifthenpay-mbway__header">
      <div class="ifthenpay-mbway__logo-wrap">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 80 32" width="80" height="32" aria-label="MB WAY">
          <rect width="80" height="32" rx="5" fill="#004b93"/>
          <text x="8" y="22" font-family="Arial,sans-serif" font-size="14" font-weight="bold" fill="#ffffff" letter-spacing="0.5">MB WAY</text>
        </svg>
      </div>
      <h2 class="ifthenpay-mbway__title">{{ 'Aguarda confirmação'|t }}</h2>
    </div>

    <div class="ifthenpay-mbway__spinner">
      <div class="ifthenpay-mbway__spinner-ring"></div>
    </div>

    <div class="ifthenpay-mbway__info">
      <p>{{ 'Foi enviado um pedido de <strong>%amount €</strong> para o número <strong>%phone</strong>.'|t({'%amount': amount, '%phone': phone})|raw }}</p>
      <p class="ifthenpay-mbway__info-sub">{{ 'Abra a app MB WAY e aprove o pagamento.'|t }}</p>
    </div>

    <div class="ifthenpay-mbway__countdown">
      <span class="ifthenpay-mbway__countdown-label">{{ 'Tempo restante'|t }}</span>
      <span class="ifthenpay-mbway__countdown-value" id="ifthenpay-mbway-timer">--:--</span>
    </div>

  </div>

  {# Estado: pago (escondido, mostrado pelo JS) #}
  <div class="ifthenpay-mbway__state ifthenpay-mbway__state--paid" id="ifthenpay-mbway-state-paid" style="display:none">
    <div class="ifthenpay-mbway__icon ifthenpay-mbway__icon--success">✓</div>
    <h2 class="ifthenpay-mbway__title ifthenpay-mbway__title--success">{{ 'Pagamento confirmado!'|t }}</h2>
    <p>{{ 'O seu pagamento MB WAY foi aprovado com sucesso.'|t }}</p>
  </div>

  {# Estado: falhou (escondido, mostrado pelo JS) #}
  <div class="ifthenpay-mbway__state ifthenpay-mbway__state--failed" id="ifthenpay-mbway-state-failed" style="display:none">
    <div class="ifthenpay-mbway__icon ifthenpay-mbway__icon--error">✕</div>
    <h2 class="ifthenpay-mbway__title ifthenpay-mbway__title--error">{{ 'Pagamento não confirmado'|t }}</h2>
    <p id="ifthenpay-mbway-failed-msg"></p>
  </div>

</div>
