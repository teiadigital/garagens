{#
/**
 * @file
 * Template da lista de garagens do utilizador.
 */
#}

{{ attach_library('garagem_pesquisa/cards') }}

{% set estado_label = {
  '-1': 'Não acabado',
  '0':  'Aguarda aprovação',
  '1':  'Com erros',
  '2':  'Não aprovado',
  '3':  'Aprovado',
} %}
{% set estado_badge = {
  '-1': 'bg-gray-700 text-white',
  '0':  'bg-blue-600 text-white',
  '1':  'bg-yellow-500 text-white',
  '2':  'bg-red-600 text-white',
  '3':  'bg-green-600 text-white',
} %}

<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-bold text-gray-900">{{ 'As minhas garagens'|t }}</h1>
</div>

{% if items is empty %}
  <div class="rounded-2xl p-10 flex flex-col items-center gap-3 text-center" style="background:#f9fafb; border:1px solid #e5e7eb">
    <div class="w-12 h-12 rounded-2xl flex items-center justify-center" style="background:#f3f4f6">
      <svg class="w-6 h-6 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
      </svg>
    </div>
    <p class="text-sm font-semibold text-gray-500">{{ 'Ainda não tens garagens.'|t }}</p>
    <p class="text-xs text-gray-400">{{ 'Adiciona a tua primeira garagem e começa a receber reservas.'|t }}</p>
  </div>
{% else %}
  <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 lg:gap-6" style="align-items:start">
    {% for item in items %}
      {% set e_key = item.estado ~ '' %}
      {% set e_label = estado_label[e_key]|default('') %}
      {% set e_badge = estado_badge[e_key]|default('bg-gray-700 text-white') %}

      <div class="garagem-card relative">
        <a href="{{ item.url }}" class="absolute inset-0 z-10" aria-label="{{ item.titulo }}"></a>
        <div class="garagem-card-img" style="pointer-events:none">
          {% if item.foto_url %}
            <img src="{{ item.foto_url }}" alt="{{ item.titulo }}">
          {% endif %}
          {% if e_label %}
            <span class="absolute top-2.5 left-2.5 {{ e_badge }} text-xs font-semibold px-2.5 py-1 rounded-full" style="z-index:20">
              {{ e_label|t }}
            </span>
          {% endif %}
          <a href="{{ item.edit_url }}"
             class="absolute bottom-2.5 right-2.5 inline-flex items-center gap-1 text-xs font-semibold px-2.5 py-1.5 rounded-lg transition hover:opacity-90"
             style="background:rgba(255,255,255,0.92); backdrop-filter:blur(4px); color:#111827; z-index:20; pointer-events:auto">
            <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
            </svg>
            {{ 'Editar'|t }}
          </a>
        </div>
        <div class="card-info" style="pointer-events:none">
          <div class="card-info-top">
            <p class="card-titulo">{{ item.titulo }}</p>
          </div>
          {% if item.localidade %}
            <p class="card-localidade">{{ item.localidade }}</p>
          {% endif %}
        </div>
      </div>
    {% endfor %}
  </div>
{% endif %}
