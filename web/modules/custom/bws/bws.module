/**
 * Create a Product instance for this node.
 */
function bws_create_node_product($node) {
  $store_storage = \Drupal::entityTypeManager()->getStorage('commerce_store');
  $default_store = $store_storage->loadDefault();

  $variation = ProductVariation::create([
    'type' => 'bws',
    'sku' => 'bws_' . $node->bundle() . '_' . $node->id(),
    'price' => [
      'number' => 0,
      'currency_code' => $default_store->getDefaultCurrencyCode(),
    ],
  ]);
  $variation->save();
  $product = Product::create([
    'type' => 'bws_' . $node->bundle(),
    'title' => $node->label(),
    'variations' => [$variation],
    'stores' => Store::loadMultiple(),
  ]);
  $product->save();

  return $product;
}

function bws_event_series_types_add_fields() {
  bat_event_series_type_add_event_dates_field('availability_daily');
  bat_event_series_type_add_target_entity_field('availability_daily', 'bat_unit');
  bat_event_series_type_add_event_state_reference('availability_daily');
}

/**
 * Implements template_preprocess_bat_event_series().
 */
function bws_preprocess_bat_event_series(array &$variables) {
  // Fetch Event series Entity Object.
  $event_series = $variables['elements']['#bat_event_series'];

  if (!in_array($event_series->bundle(), ['availability_daily'])) {
    return;
  }

  $bat_unit = $event_series->get('event_bat_unit_reference')->entity;

  $node_storage = \Drupal::entityTypeManager()->getStorage('node');

  $query = \Drupal::entityQuery('node')->accessCheck(FALSE);
  if ($event_series->bundle() == 'availability_daily') {
    $query->condition('field_availability_daily', $bat_unit->id());
  }

  $query->accessCheck(FALSE);

  $nids = $query->execute();

  $node = $node_storage->load(reset($nids));

  $variables['content']['add_reservation'] = [
    '#theme' => 'menu_local_action',
    '#link' => [
      'title' => t('Add reservation'),
      'url' => Url::fromRoute('bws.bat_event_series.add_reservation', [
        'node' => $node->id(),
        'bat_event_series' => $event_series->id(),
      ]),
    ],
    '#prefix' => '<div class="action-links">',
    '#suffix' => '</div>',
    '#weight' => -100,
  ];
}

/**
 * @param \Drupal\node\Entity\Node $node
 * @param \Drupal\bat_booking\Entity\Booking $booking
 * @param DateTime $start_date
 * @param DateTime $end_date
 *
 * @return \Drupal\commerce_price\Price
 */
function bws_get_unit_price(Node $node, Booking $booking, DateTime $start_date, DateTime $end_date) {
  $node_type = NodeType::load($node->bundle());
  assert($node_type instanceof NodeType);
  $bws_settings = $node_type->getThirdPartySetting('bws', 'bws');

  $interval = $start_date->diff($end_date);

  $reservation_context = [
    'booking' => $booking,
    'node' => $node,
  ];

  $base_price = $node->get('field_price')->number;
  $currency_code = $node->get('field_price')->currency_code;

  if ($bws_settings['bookable_type'] == 'daily') {
    $days = $interval->days;
    $amount = number_format($base_price * $days, 2, '.', '');
  }
  else {
    $field_price_frequency = $node->get('field_price_frequency')->value;

    if ($field_price_frequency == 'hour') {
      $hours = ($interval->days * 24) + $interval->h;
      $amount = number_format($base_price * $hours, 2, '.', '');
    }
    else {
      $minutes = ($interval->days * 24 * 60) + ($interval->h * 60) + $interval->i;
      $amount = number_format($base_price * $minutes, 2, '.', '');
    }
  }

  $price = new Price($amount, $currency_code);

  \Drupal::moduleHandler()->alter('bws_reservation_price', $price, $reservation_context);

  return $price;
}

/**
  * Validate bws settings on nodes
  * @param \Drupal\node\Entity\NodeType $node_type
  *
  * @return array $bws_settings
  */
function bws_validate_thirdpartysetting(NodeType $node_type) {

  $bws_settings = $node_type->getThirdPartySetting('bws', 'bws');

  if (!isset($bws_settings)) {
    \Drupal::messenger()->addwarning(t('@nodetype content type has no valid BWS setting.', ['@nodetype' => $node_type->Id()]));
    $url = Drupal\Core\URL::fromUserInput('/admin/structure/types/manage/' . $node_type->Id());
    $link = Link::fromTextAndUrl(t('Update BWS  settings'), $url);
  }
  return $bws_settings;

}


/**
 * Add BWS features to a given instance of NodeType.
 *
 * @param string $node_type
 *   ................
 * @param array $bws_settings
 *   An associative array containing:
 *   - bookable: integer.
 *   - bookable_type: string.
 *   - availability: string.
 *   - payment: integer.
 *   - payment_default_value: integer.
 */
function bws_set_bws_to_node($node_type, $bws_settings) {

  if ($bws_settings['bookable']) {

    bws_add_availability_field('field_availability_' . $bws_settings['bookable_type'], $node_type);

    $view_display = \Drupal::entityTypeManager()->getStorage('entity_view_display')->load('node.' . $node_type->id() . '.default');
    if ($view_display !== NULL) {
      $view_display->setComponent('field_availability_' . $bws_settings['bookable_type'], [
        'type' => 'entity_reference_entity_view',
        'region' => 'content',
        'label' => 'above',
        'settings' => [
          'view_mode' => $bws_settings['bookable_type'] . '_calendar',
        ],
      ]);
      $view_display->save();
    }

    if (!isset($bws_settings['type_id'])) {
      $bat_type = bat_unit_type_create(
        [
          'name' => $node_type->label(),
          'type' => $bws_settings['bookable_type'],
        ]
      );

      if ($bws_settings['availability'] == 'available') {
        $state = bat_event_load_state_by_machine_name('bws_' . $bws_settings['bookable_type'] . '_available');
      }
      else {
        $state = bat_event_load_state_by_machine_name('bws_' . $bws_settings['bookable_type'] . '_not_available');
      }

      $bat_type->set('field_availability_' . $bws_settings['bookable_type'], $state->id());

      bat_unit_type_save($bat_type);

      $bws_settings['type_id'] = $bat_type->id();
    }

    if ($bws_settings['payment']) {
      bws_create_bws_product_variation_type();
      bws_create_bws_order_item_type();
      bws_create_bws_booking_type();

      bws_create_node_product_type($node_type);

      bws_add_product_reference_field('field_product', $node_type);
      bws_add_price_field('field_price', $node_type);
      bws_add_price_frequency_field('field_price_frequency', $node_type);

      if (!$bws_settings['payment_default_value']) {
        $node_storage = \Drupal::entityTypeManager()->getStorage('node');

        $query = \Drupal::entityQuery('node')
          ->accessCheck(FALSE)
          ->condition('type', $node_type->id());

        $nids = $query->execute();
        foreach ($node_storage->loadMultiple($nids) as $node) {
          if (!$node->get('field_product')->entity) {
            $product = bws_create_node_product($node);

            $node->set('field_product', $product->id());
            $node->save();
          }
        }
      }
    }

    $node_type->setThirdPartySetting('bws', 'bws', $bws_settings)->save();
  }
  else {
    if (isset($bws_settings['type_id'])) {
      $node_storage = \Drupal::entityTypeManager()->getStorage('node');

      $query = \Drupal::entityQuery('node')
        ->accessCheck(FALSE)
        ->condition('type', $node_type->id());

      $nids = $query->execute();
      foreach ($node_storage->loadMultiple($nids) as $node) {
        if ($node->hasField('field_availability_' . $bws_settings['bookable_type'])) {
          if ($bat_unit = $node->get('field_availability_' . $bws_settings['bookable_type'])->entity) {
            bat_unit_delete($bat_unit);
          }
        }
      }

      $bat_type = bat_unit_type_load($bws_settings['type_id']);
      $bat_type->delete();
    }

    $node_type->unsetThirdPartySetting('bws', 'bws')->save();
  }

}



function bws_create_require_bat_states() {

  $states = [
    'bws_daily_available' => [
      'name' => 'Available',
      'color' => '#42f649',
      'calendar_label' => 'AV',
      'blocking' => 0,
      'machine_name' => 'bws_daily_available',
      'event_type' => 'availability_daily',
    ],
    'bws_daily_not_available' => [
      'name' => 'Not available',
      'color' => '#f04b4b',
      'calendar_label' => 'N/A',
      'blocking' => 0,
      'machine_name' => 'bws_daily_not_available',
      'event_type' => 'availability_daily',
    ],
    'bws_daily_booked' => [
      'name' => 'Booked',
      'color' => '#4b3cea',
      'calendar_label' => 'BOOK',
      'blocking' => 1,
      'machine_name' => 'bws_daily_booked',
      'event_type' => 'availability_daily',
    ],
    'bws_daily_pending' => [
      'name' => 'Pending',
      'color' => '#FAFAC2',
      'calendar_label' => 'PENDING',
      'blocking' => 1,
      'machine_name' => 'bws_daily_pending',
      'event_type' => 'availability_daily',
    ],
  ];

  foreach ($states as $state) {
    bat_event_create_state($state)->save();
  }

}