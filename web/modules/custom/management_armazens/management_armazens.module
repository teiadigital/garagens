<?php

use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Url;
use Symfony\Component\HttpFoundation\RedirectResponse;
use Drupal\Core\Ajax\AjaxResponse;
use Drupal\Core\Ajax\RedirectCommand;

/**
 * @file
 * Primary module hooks for management armazem module.
 */

function management_armazens_theme($existing, $type, $theme, $path) {
  $module_path = \Drupal::service('extension.list.module')->getPath('management_armazens');

  return [
    'info_details_user' => ['variables' => ['data' => []]],
    'info_details_user_dashboard' => ['variables' => ['data' => []]],
    'actions_armazens' => [
      'variables' => ['data' => NULL, 'form' => NULL],
      'template' => 'actions-armazens',
      'path' => $module_path . '/templates',
    ],
  ];
}

function management_armazens_preprocess_block(&$variables) {
  if ($variables['plugin_id'] == "local_actions_block") {
    $variables['elements']['#cache']['max-age'] = 0;
    $variables['#cache']['max-age'] = 0;
  }
}

function management_armazens_options_list_alter(array &$options, array $context) {
  unset($options['_none']);
}

/**
 * form_alter para outros forms (views/pedidos/etc).
 */
function management_armazens_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  // View exposed filter (mapa).
  if ($form_id == 'views_exposed_form' && ($form['#id'] ?? '') === 'views-exposed-form-armazens-page-armazens') {
    $country = $form_state->getUserInput()['field_localidade_country_code'] ?? NULL;
    $administrative_area = $form_state->getUserInput()['field_localidade_administrative_area'] ?? NULL;

    if ($country && $country !== 'All') {
      $address = ($administrative_area && $administrative_area !== 'All') ? ($administrative_area . ', ' . $country) : $country;
      $api_key = '65e051e8653e3622949358ujic3da8d';
      $url     = "https://geocode.maps.co/search?q=" . urlencode($address) . "&api_key=" . $api_key;

      $json = @file_get_contents($url);
      $json = $json ? json_decode($json) : NULL;

      if ($json && !empty($json[0])) {
        $html = '<div style="display: none;" id="cc_map_lon">' . $json[0]->lon . '</div>'
          . '<div style="display: none;" id="cc_map_lat">' . $json[0]->lat . '</div>';
        $form['mymarkup'] = ['#markup' => $html];
      }
    }
  }

  // Node pedidos.
  if ($form_id == 'node_pedidos_form') {
    if (isset($form['title']['widget'][0]['value']['#default_value']) && $form['title']['widget'][0]['value']['#default_value'] === NULL) {
      $form['title']['widget'][0]['value']['#default_value'] = 'initial';
    }
    $form['field_vedacao']['#states']       = ['visible' => [':input[name="field_espaco"]' => ['value' => 'aberto']]];
    $form['field_camara_de_frio']['#states'] = ['visible' => [':input[name="field_tem_camaras_de_frio"]' => ['value' => 'sim']]];
    $form['field_raques']['#states']         = ['visible' => [':input[name="field_tem_raques"]' => ['value' => 'sim']]];
  }

  // Node armazem (genérico).
  if ($form_id == 'node_armazem_form') {
    if (isset($form['title']['widget'][0]['value']['#default_value']) && $form['title']['widget'][0]['value']['#default_value'] === NULL) {
      $form['title']['widget'][0]['value']['#default_value'] = 'initial';
    }

    // Apenas cosmética/UX agrupamentos.
    $form['field_documento_licenca']['widget']['#type'] = 'fieldset';
    $form['field_documento_seguro_imovel']['widget']['#type'] = 'fieldset';
    $form['field_documentos']['widget']['#type'] = 'fieldset';
    $form['field_comprovativo_do_seguro']['widget']['#type'] = 'fieldset';
    $form['field_fotos']['widget']['#type'] = 'fieldset';
    $form['field_grelha_horarios']['widget']['#type'] = 'fieldset';
    $form['field_grelha_horarios_office_hours_0']['widget']['#type'] = 'fieldset';

    \Drupal::request()->getSession()->set('temp_var_precos_validation', NULL);
  }

   if (isset($form['field_espaco']['widget'])) {
    $form['field_espaco']['widget']['#empty_option'] = t('-- Selecionar --');
    $form['field_espaco']['widget']['#empty_value'] = '_none';
  }
   if (isset($form['field_carga_adr']['widget'])) {
    $form['field_carga_adr']['widget']['#empty_option'] = t('-- Selecionar --');
    $form['field_carga_adr']['widget']['#empty_value'] = '_none';
  }
  if (isset($form['field_limitacoes_carga_descarga']['widget'])) {
    $form['field_limitacoes_carga_descarga']['widget']['#empty_option'] = t('-- Selecionar --');
    $form['field_limitacoes_carga_descarga']['widget']['#empty_value'] = '_none';
  }
}

/**
 * Alter do form de node (apanha os steps do EFS).
 */
function management_armazens_form_node_form_alter(array &$form, FormStateInterface $form_state) {
  $entity = $form_state->getFormObject() ? $form_state->getFormObject()->getEntity() : NULL;
  if (!$entity || $entity->getEntityTypeId() !== 'node' || $entity->bundle() !== 'armazem') {
    return;
  }

  // Título mínimo no "add".
  if ($entity->isNew() && ($entity->getTitle() === '' || $entity->getTitle() === NULL)) {
    $entity->setTitle('initial');
  }
  if (isset($form['title']['widget'][0]['value'])) {
    $title_el = &$form['title']['widget'][0]['value'];
    if (empty($title_el['#default_value']) && empty($title_el['#value'])) {
      $title_el['#default_value'] = 'initial';
    }
  }

  // Validações por step (só quando os campos existem).
  if (isset($form['field_localidade'])) {
    $form['#validate'][] = 'management_armazens_validate_postal_code';
  }
  _ma_attach_ief_validators($form);

  // *** CHAVE: validador GLOBAL do formulário que salva rascunho no NEXT. ***
  // Corre SEMPRE (mesmo que o botão NEXT não execute callbacks #submit).
  if (!in_array('management_armazens_guardian_validate', (array) ($form['#validate'] ?? []), TRUE)) {
    $form['#validate'][] = 'management_armazens_guardian_validate';
  }

  // AFTER_BUILD para detectar labels e re-anexar handlers (quando houver).
  $form['#after_build'][] = 'management_armazens_after_build_attach_handlers';
}

/**
 * AFTER_BUILD: anexa handlers conforme o label do botão.
 */
function management_armazens_after_build_attach_handlers(array $form, FormStateInterface $form_state) {
  if (empty($form['actions']) || !is_array($form['actions'])) {
    return $form;
  }

  \Drupal::logger('management_armazens')->notice(
    'AFTER BUILD ACTIONS: @keys',
    ['@keys' => implode(', ', array_keys($form['actions']))]
  );

  // SAVE & EXIT intermédio -> rascunho (-1).
  if (isset($form['actions']['save_resume_exit']) && ($form['actions']['save_resume_exit']['#type'] ?? '') === 'submit') {
    $ex = (array) ($form['actions']['save_resume_exit']['#submit'] ?? []);
    if (!in_array('management_armazens_next_submit', $ex, TRUE)) {
      array_unshift($ex, 'management_armazens_next_submit');
      $form['actions']['save_resume_exit']['#submit'] = $ex;
    }
    $vx = (array) ($form['actions']['save_resume_exit']['#validate'] ?? []);
    if (!in_array('management_armazens_next_validate_save', $vx, TRUE)) {
      array_unshift($vx, 'management_armazens_next_validate_save');
      $form['actions']['save_resume_exit']['#validate'] = $vx;
    }
  }

  // actions[submit] -> NEXT ou FINISH consoante o label.
  if (isset($form['actions']['submit']) && ($form['actions']['submit']['#type'] ?? '') === 'submit') {
    $label = (string) ($form['actions']['submit']['#value'] ?? '');
    $norm  = mb_strtolower(trim(html_entity_decode($label)));

    $next_aliases   = ['next','seguinte','siguiente','suivant','weiter','avançar', mb_strtolower((string) t('Next'))];
    $finish_aliases = ['finish','guardar','save','submit','finalizar', mb_strtolower((string) t('Finish')), mb_strtolower((string) t('Save'))];

    if (in_array($norm, $next_aliases, TRUE)) {
      $existing_submit = (array) ($form['actions']['submit']['#submit'] ?? []);
      $existing_valid  = (array) ($form['actions']['submit']['#validate'] ?? []);
      if (!in_array('management_armazens_next_submit', $existing_submit, TRUE)) {
        array_unshift($existing_submit, 'management_armazens_next_submit');
        $form['actions']['submit']['#submit'] = $existing_submit;
      }
      if (!in_array('management_armazens_next_validate_save', $existing_valid, TRUE)) {
        array_unshift($existing_valid, 'management_armazens_next_validate_save');
        $form['actions']['submit']['#validate'] = $existing_valid;
      }
      \Drupal::logger('management_armazens')->notice('AFTER BUILD: attached NEXT to actions[submit] (label=@l).', ['@l' => $label]);
    }
    else {
      $existing_submit = (array) ($form['actions']['submit']['#submit'] ?? []);
      if (!in_array('management_armazens_finish_submit', $existing_submit, TRUE)) {
        $existing_submit[] = 'management_armazens_finish_submit';
        $form['actions']['submit']['#submit'] = $existing_submit;
      }
      \Drupal::logger('management_armazens')->notice('AFTER BUILD: attached FINISH to actions[submit] (label=@l).', ['@l' => $label]);
    }
  }

  // Outros botões finais típicos do EFS/Field Group.
  foreach (['entity_form_steps_step_submit', 'save_and_exit'] as $key) {
    if (isset($form['actions'][$key]) && ($form['actions'][$key]['#type'] ?? '') === 'submit') {
      $exist = (array) ($form['actions'][$key]['#submit'] ?? []);
      if (!in_array('management_armazens_finish_submit', $exist, TRUE)) {
        $exist[] = 'management_armazens_finish_submit';
        $form['actions'][$key]['#submit'] = $exist;
      }
      \Drupal::logger('management_armazens')->notice('AFTER BUILD: attached FINISH to actions[@k].', ['@k' => $key]);
    }
  }

  return $form;
}

/**
 * Guarda rascunho (-1) via VALIDATE (corre sempre no NEXT).
 */
function management_armazens_next_validate_save(array &$form, FormStateInterface $form_state) {
  management_armazens__save_draft_if_needed($form_state, 'VALIDATE');
}

/**
 * Guarda rascunho (-1) via SUBMIT (se o wizard chamar #submit).
 */
function management_armazens_next_submit(array &$form, FormStateInterface $form_state) {
  management_armazens__save_draft_if_needed($form_state, 'SUBMIT');

  // Se for "Save & Exit", redireciona.
  $trigger = $form_state->getTriggeringElement();
  $name    = (string) ($trigger['#name'] ?? '');
  if (str_contains($name, 'save_resume_exit')) {
    $url = Url::fromUserInput('/pt/user/');
    $form_state->setRedirectUrl($url);
    $req = \Drupal::request();
    if ($req->isXmlHttpRequest()) {
      $resp = new AjaxResponse();
      $resp->addCommand(new RedirectCommand($url->toString()));
      $form_state->setResponse($resp);
    } else {
      $form_state->setResponse(new RedirectResponse($url->toString()));
    }
    $form_state->setRebuild(FALSE);
  }
}

/**
 * Validador GLOBAL do form: deteta NEXT/SAVE&EXIT e garante rascunho.
 */
/**
 * Validador GLOBAL do form: trata NEXT e também o FINISH (fallback).
 */
function management_armazens_guardian_validate(array &$form, FormStateInterface $form_state) {
  // 1) NEXT / SAVE & EXIT intermédio -> rascunho (-1).
  management_armazens__save_draft_if_needed($form_state, 'FORM_VALIDATE');

  // 2) FINISH -> estado 0 (aguardar aprovação).
  static $done_final = FALSE;
  if ($done_final) {
    return;
  }

  $trigger = $form_state->getTriggeringElement();
  if (!$trigger) {
    return;
  }

  $name  = (string) ($trigger['#name']  ?? '');
  $label = (string) ($trigger['#value'] ?? '');
  $norm  = mb_strtolower(trim(html_entity_decode($label)));

  $finish_aliases = ['finish','guardar','save','submit','finalizar', mb_strtolower((string) t('Finish')), mb_strtolower((string) t('Save'))];

  $is_finish_btn =
       in_array($norm, $finish_aliases, TRUE)
    || str_contains($name, 'entity_form_steps_step_submit')
    || str_contains($name, 'save_and_exit');

  if (!$is_finish_btn) {
    return;
  }

  /** @var \Drupal\node\NodeInterface $entity */
  $entity = $form_state->getFormObject()->getEntity();

  try {
    $entity->set('field_estado', 0); // Aguardar aprovação
    $entity->setUnpublished();       // continua por aprovar
    // Não é obrigatório gravar aqui, mas gravamos como fallback caso o wizard
    // não chame #submit do botão final.
    if (method_exists($entity, 'validate')) {
      $entity->validate();
    }
    $entity->save();
    $done_final = TRUE;
    \Drupal::logger('management_armazens')->notice('Final (0) set via FORM_VALIDATE for node @nid.', ['@nid' => $entity->id()]);
  }
  catch (\Throwable $t) {
    \Drupal::logger('management_armazens')->error('Final save (validate) failed: @m', ['@m' => $t->getMessage()]);
  }
}


/**
 * Helper: decide se é NEXT/SAVE&EXIT e, sendo, grava rascunho (-1).
 */
function management_armazens__save_draft_if_needed(FormStateInterface $form_state, string $origin) {
  static $once = FALSE;
  if ($once) {
    return;
  }

  $trigger = $form_state->getTriggeringElement();
  if (!$trigger) {
    return;
  }

  $name  = (string) ($trigger['#name']  ?? '');
  $label = (string) ($trigger['#value'] ?? '');
  $norm  = mb_strtolower(trim(html_entity_decode($label)));

  $next_aliases = ['next','seguinte','siguiente','suivant','weiter','avançar', mb_strtolower((string) t('Next'))];

  $is_next          = in_array($norm, $next_aliases, TRUE) || str_contains($name, 'entity_form_steps_next');
  $is_save_and_exit = str_contains($name, 'save_resume_exit') || str_contains($name, 'save_and_exit');

  if (!($is_next || $is_save_and_exit)) {
    return;
  }

  /** @var \Drupal\node\NodeInterface $entity */
  $entity = $form_state->getFormObject()->getEntity();

  // Mínimo para salvar já no 1.º passo.
  if ($entity->isNew() && !$entity->getTitle()) {
    $entity->setTitle('initial');
  }
  if (method_exists($entity, 'setValidationRequired')) {
    $entity->setValidationRequired(FALSE);
  }

  try {
    $entity->set('field_estado', -1);
    $entity->setUnpublished();
    $entity->save();
    $once = TRUE; // evita múltiplos saves no mesmo ciclo
    \Drupal::logger('management_armazens')->notice('Draft (-1) saved on NEXT via @o for node @nid.', [
      '@o' => $origin,
      '@nid' => $entity->id(),
    ]);
  }
  catch (\Throwable $t) {
    \Drupal::logger('management_armazens')->error('Draft save failed (@o): @m', ['@o' => $origin, '@m' => $t->getMessage()]);
  }
}

/**
 * FINISH -> estado 0 (aguardar aprovação), unpublished.
 */
function management_armazens_finish_submit(array &$form, FormStateInterface $form_state) {
  /** @var \Drupal\node\NodeInterface $entity */
  $entity = $form_state->getFormObject()->getEntity();

  try {
    $entity->set('field_estado', 0);
    $entity->setUnpublished();
    if (method_exists($entity, 'validate')) {
      $entity->validate();
    }
    $entity->save();
    \Drupal::logger('management_armazens')->notice('Final (0) saved on FINISH for node @nid.', ['@nid' => $entity->id()]);
  }
  catch (\Throwable $t) {
    \Drupal::logger('management_armazens')->error('Finish save failed: @m', ['@m' => $t->getMessage()]);
  }

  management_armazens_send_email($form, $form_state);
  management_armazens_send_email_gestor($form, $form_state);
}

/* =========================
 *  RESTANTE LÓGICA / HELPERS
 * ========================= */

function management_armazens_entity_presave(Drupal\Core\Entity\EntityInterface $entity) {
  if ($entity->getEntityTypeId() !== 'node') {
    return;
  }

  if ($entity->bundle() == 'armazem') {
    $original_title = $entity->getTitle();
    if ($original_title == "initial") {
      $country_code = $entity->get('field_localidade')->getValue()[0]['country_code'] ?? '';
      $ano = date('y');
      $mes = date('m');

      $query = \Drupal::entityQuery('node');
      $query->accessCheck(FALSE)
        ->condition('type', 'armazem')
        ->condition('field_localidade.country_code', $country_code)
        ->condition('created', strtotime("$ano-$mes-01"), '>=')
        ->condition('created', strtotime("$ano-$mes-01 +1 month"), '<')
        ->sort('created', 'DESC')
        ->range(0, 1);

      $nids = $query->execute();
      $nodes = \Drupal::entityTypeManager()->getStorage('node')->loadMultiple($nids);
      $latest_node = reset($nodes);

      if ($latest_node) {
        $title = $latest_node->label();
        $newstring = substr($title, -4);
        if (is_numeric($newstring)) {
          $inc = (int) $newstring + 1;
          $formatted = sprintf('%04d', $inc);
          $final = $country_code . $ano . $mes . $formatted;
        }
        else {
          $final = $country_code . $ano . $mes . '0001';
        }
      }
      else {
        $final = $country_code . $ano . $mes . '0001';
      }

      $entity->setTitle($final);
    }
  }

  if ($entity->bundle() == 'pedidos') {
    $original_title = $entity->getTitle();

    if ($original_title == "initial") {
      $ano = date('y');
      $mes = date('m');

      $query = \Drupal::entityQuery('node');
      $query->accessCheck(FALSE)
        ->condition('type', 'pedidos')
        ->condition('created', strtotime("$ano-$mes-01"), '>=')
        ->condition('created', strtotime("$ano-$mes-01 +1 month"), '<')
        ->sort('created', 'DESC')
        ->range(0, 1);

      $nids = $query->execute();
      $nodes = \Drupal::entityTypeManager()->getStorage('node')->loadMultiple($nids);
      $latest_node = reset($nodes);

      if ($latest_node) {
        $title = $latest_node->label();
        $newstring = substr($title, -4);
        if (is_numeric($newstring)) {
          $inc = (int) $newstring + 1;
          $formatted = sprintf('%04d', $inc);
          $final = 'REQ' . $ano . $mes . $formatted;
        } else {
          $final = 'REQ' . $ano . $mes . '0001';
        }
      } else {
        $final = 'REQ' . $ano . $mes . '0001';
      }

      $entity->setTitle($final);
    }
  }

  if ($entity->isNew()) {
    $estado = $entity->get('field_estado')->value ?? NULL;
    if ($estado === NULL || $estado === '') {
      $entity->set('field_estado', -1);
      $entity->setUnpublished();
    }
    if ($estado == 0) {
      $entity->setUnpublished();
    }
    if ($estado == -1) {
      $entity->setUnpublished();
    }
  }
}

/** Compatibilidade. */
function management_armazens_change_state_on_edit(array $form, FormStateInterface $form_state) {
  $node = $form_state->getFormObject()->getEntity();
  $node->set('field_estado', -1);
  $node->setUnpublished();
  $node->save();
}

function management_armazens_save_coordinates_address(array $form, FormStateInterface $form_state) {
  $node = $form_state->getFormObject()->getEntity();

  $postal_code  = $node->get('field_localidade')->getValue()[0]['postal_code']  ?? '';
  $country_code = $node->get('field_localidade')->getValue()[0]['country_code'] ?? '';

  if ($postal_code && $country_code) {
    $url  = "http://api.geonames.org/postalCodeLookupJSON?postalcode={$postal_code}&country={$country_code}&username=teiadigital";
    $json = @file_get_contents($url);
    $json = $json ? json_decode($json) : NULL;

    if ($json && !empty($json->postalcodes[0])) {
      $coordenadas = $json->postalcodes[0]->lat . ',' . $json->postalcodes[0]->lng;
      $node->set('field_coordenadas', $coordenadas);
      $node->save();
    }
  }
}

function management_armazens_check_fotos(array $form, FormStateInterface $form_state) {
  $node  = $form_state->getFormObject()->getEntity();
  $fotos = $node->get('field_fotos')->getValue();

  $node->set('field_tem_fotos', !empty($fotos));
  $node->save();
}

function management_armazens_send_email(array $form, FormStateInterface $form_state) {
  $node = $form_state->getFormObject()->getEntity();
  $node->set('field_estado', 0);
  $node->setUnpublished();
  $node->save();

  $user_email = \Drupal::currentUser()->getEmail();

  $mailManager = \Drupal::service('plugin.manager.mail');
  $module = 'management_armazens';
  $key = 'general_mail';
  $to = $user_email;
  $params['subject'] = t("Your warehouse has been successfully created.");
  $params['body'] = t("Thank you for using the platform. <br>"
    . "In the next few hours you will receive a notification confirming the publication or requesting any rectifications. <br>"
    . "I'm sure we'll meet soon in this or another warehouse.<br><br><br>"
    . "See you soon!");

  $langcode = \Drupal::currentUser()->getPreferredLangcode();
  $send = TRUE;
  $result = $mailManager->mail($module, $key, $to, $langcode, $params, NULL, $send);

  if (empty($result['result'])) {
    \Drupal::messenger()->addError(t('There was a problem sending your message and it was not sent.'), 'error');
  }
}

function management_armazens_send_email_gestor(array $form, FormStateInterface $form_state) {

\Drupal::logger('management_armazens')->notice('ENTREI em send_email_gestor()');


  $node = $form_state->getFormObject()->getEntity();
  $title = $node->getTitle();

  $user_storage = \Drupal::entityTypeManager()->getStorage('user');
  $user_ids = $user_storage->getQuery()
    ->condition('status', 1)
    ->accessCheck(FALSE)
    ->condition('roles', 'gestor')
    ->execute();

  $users = $user_storage->loadMultiple($user_ids);

  $mailManager = \Drupal::service('plugin.manager.mail');
  $module = 'management_armazens';
  $key = 'general_mail';
  $params['subject'] = t("Foi criado um novo armazem na plataforma.");
  $params['body'] = t("Foi criado um novo armazem @title na plataforma Storitflex.", ['@title' => $title]);

  $send = TRUE;

  foreach ($users as $user) {
    $to = $user->getEmail();
    $langcode = $user->getPreferredLangcode();

    $result = $mailManager->mail($module, $key, $to, $langcode, $params, NULL, $send);
    if (empty($result['result'])) {
      \Drupal::messenger()->addError(t('There was a problem sending your message and it was not sent.'), 'error');
    }
  }
}

function management_armazens_mail($key, &$message, $params) {
  switch ($key) {
    case 'general_mail':
      $site_mail = \Drupal::config('system.site')->get('mail') ?: 'no-reply@' . \Drupal::request()->getHost();
      $message['from'] = $site_mail;
      $message['subject'] = preg_replace("/[\r\n]+/", ' ', $params['subject']);
      $message['body'][] = $params['body'];
      break;
  }
}

function management_armazens_theme_suggestions_input_alter(&$suggestions, array $variables) {
  if (($variables['element']['#type'] ?? '') === 'submit') {
    $classes = $variables['element']['#attributes']['class'] ?? [];
    if (in_array('remove-button', $classes, TRUE)) {
      $suggestions[] = 'input__remove_button';
    }
  }
}

/**
 * Inline Entity Form alters/validators (iguais aos teus, só aplicados quando existirem).
 */
function management_armazens_inline_entity_form_entity_form_alter(&$entity_form, &$form_state) {
  if (in_array('field_preco_full', $entity_form['#parents'] ?? [], TRUE)) {
    $entity_form['field_preco_ano']['widget'][0]['value']['#title'] = t("Preço ano (€)");
    $entity_form['field_preco_dia']['widget'][0]['value']['#title'] = t("Preço dia (€)");
    $entity_form['field_preco_mes']['widget'][0]['value']['#title'] = t("Preço mês (€)");
    $entity_form['#element_validate'][] = 'management_armazens_validate_prices_aluguer_do_imovel';
  }

  if (in_array('field_preco_partilhado', $entity_form['#parents'] ?? [], TRUE)) {
    $entity_form['#element_validate'][] = 'management_armazens_validate_prices_aluguer_por_area';
  }

  if (in_array('field_preco_temp', $entity_form['#parents'] ?? [], TRUE)) {
    $entity_form['field_preco_ano']['widget'][0]['value']['#title'] = t("Preço ano (€/Un)");
    $entity_form['field_preco_dia']['widget'][0]['value']['#title'] = t("Preço dia (€/Un)");
    $entity_form['field_preco_mes']['widget'][0]['value']['#title'] = t("Preço mês (€/Un)");
    $entity_form['#element_validate'][] = 'management_armazens_validate_prices_aluguer_camara_de_frio';
  }

  if (in_array('field_euro_paletes', $entity_form['#parents'] ?? [], TRUE)) {
    $entity_form['#element_validate'][] = 'management_armazens_validate_prices_aluguer_euro_paletes';
  }

  if (in_array('field_paletes_americanas', $entity_form['#parents'] ?? [], TRUE)) {
    $entity_form['#element_validate'][] = 'management_armazens_validate_prices_aluguer_paletes_ameri';
  }

  if (in_array('field_area_partilhada', $entity_form['#parents'] ?? [], TRUE)) {
    $entity_form['#element_validate'][] = 'management_armazens_validate_area_partilhada';
  }

  if (in_array('field_raques', $entity_form['#parents'] ?? [], TRUE)) {
    $entity_form['#element_validate'][] = 'management_armazens_validate_raques';
  }
}

function management_armazens_validate_prices_aluguer_do_imovel(&$entity_form, &$form_state) {
  if (($form_state->getValues()['field_bool_aluguer_do_imovel']['value'] ?? 0) == 1) {
    $ano = (float) ($entity_form['field_preco_ano']['widget'][0]['value']['#value'] ?? 0);
    $dia = (float) ($entity_form['field_preco_dia']['widget'][0]['value']['#value'] ?? 0);
    $mes = (float) ($entity_form['field_preco_mes']['widget'][0]['value']['#value'] ?? 0);

    $session = \Drupal::request()->getSession();
    if ($session->get('temp_var_precos_validation') == NULL) {
      if ($dia >= $mes) {
        $form_state->setError($entity_form, t("The day's price is greater than or equal to the month's, if the information is correct click next."));
        $session->set('temp_var_precos_validation', 1);
      }
      if ($mes >= $ano) {
        $form_state->setError($entity_form, t('The price for the month is greater than or equal to the price for the year, if the information is correct click next.'));
        $session->set('temp_var_precos_validation', 1);
      }
    }
  }
}

