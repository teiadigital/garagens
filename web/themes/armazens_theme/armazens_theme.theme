<?php

use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\StringTranslation\TranslatableMarkup;
use Drupal\Core\Url;

/**
 * @file
 * Functions to support theming.
 */

/**
 * Implements hook_preprocess_image_widget().
 */

function armazens_theme_preprocess(array &$variables) {
  $variables['is_front'] = \Drupal::service('path.matcher')->isFrontPage();
  $variables['route_name'] = \Drupal::routeMatch()->getRouteName();

}

function armazens_theme_preprocess_image_widget(array &$variables) {
  $data = &$variables['data'];

  // This prevents image widget templates from rendering preview container HTML
  // to users that do not have permission to access these previews.
  // @todo revisit in https://drupal.org/node/953034
  // @todo revisit in https://drupal.org/node/3114318
  if (isset($data['preview']['#access']) && $data['preview']['#access'] === FALSE) {
    unset($data['preview']);
  }
}

function armazens_theme_form_user_login_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  // Add reset password link.
  $url_object = Url::fromRoute('user.pass');
  $form['password_reset_link'] = [
    '#type' => 'link',
    '#url' => $url_object,
    '#title' => new TranslatableMarkup('Forgotten your or password? <b class="underline">Click here</b>'),
    '#attributes' => [
      'class' => ['user-reset-password-link text-sm mb-8 block w-fit'],
    ],
  ];
}



function armazens_theme_form_alter(&$form, \Drupal\Core\Form\FormStateInterface $form_state, $form_id) {

  $fields = [
    'field_certificados',
    'field_controlo_acesso',
    'field_espaco',
    'field_incluir_espaco_exterior',
    'field_licenca_de_utilizacao',
    'field_licenca_utilizacao',
    'field_limitacoes_de_acesso',
    'field_limitacoes_horario_acesso',
    'field_recursos',
    'field_seguranca',
    'field_seguro',
    'field_sistema_detecao_incendios',
  ];

  foreach ($fields as $field) {
    if (isset($form[$field]['widget'])) {
      $form[$field]['widget']['#empty_option'] = '-- Selecionar --';
      $form[$field]['widget']['#empty_value'] = '_none';
    }
  }

  if (!empty($form['#entity_form_steps']) || preg_match('/^node_armazem_step_\d+_form$/', $form_id)) {
    return;
  }


  if($form_id == 'mailchimp_signup_subscribe_block_subscribe_form') {
    
    $form['mergevars']['EMAIL']['#title_display'] = 'invisible';
    $form['mergevars']['EMAIL']['#attributes']['placeholder'] = t('Email*');
  }

 

  $form['revision_information']['#access'] = FALSE;
  $form['actions']['preview']['#access'] = FALSE;

  $form['field_documentos']['widget']['#type'] = 'fieldset';

  if($form_id == 'node_advertising_form' || $form_id == 'node_advertising_edit_form' ) {
    $form['field_image']['widget']['#type'] = 'fieldset';
  }
  
  if($form_id == 'node_armazem_form') {
    $form['field_fotos']['widget']['#type'] = 'fieldset';
    $form['field_localidade']['widget'][0]['#type'] = 'fieldset';

  }

if ($form_id == 'node_armazem_step_5_form' && isset($form['field_horarios']['widget'][0])) {
  $form['field_horarios']['widget'][0]['#title'] = $form['field_horarios']['widget']['#title'] ?? '';
  $form['field_horarios']['widget'][0]['#type'] = 'fieldset';
}

  if($form_id == 'node_armazem_step_6_form') {

    $form['field_comprovativo_do_seguro']['widget']['#type'] = 'fieldset';
    $form['field_documento_seguro_carga']['widget']['#type'] = 'fieldset';
    $form['field_documento_seguro_imovel']['widget']['#type'] = 'fieldset';
    $form['field_documento_licenca']['widget']['#type'] = 'fieldset';
  }
}


function armazens_theme_form_node_armazem_form_alter(array &$form, \Drupal\Core\Form\FormStateInterface $form_state) {
  if (!empty($form['#entity_form_steps'])) {
    $info = $form['#entity_form_steps'];
    \Drupal::messenger()->addStatus('Wizard ativo — passo atual: ' . ($info['current_step'] ?? '?'));
    return; // não tocar no form quando o wizard está ativo
  }
  
  if (!empty($form['#entity_form_steps'])) {
    $info    = $form['#entity_form_steps'] ?? [];
    $current = $info['current_step'] ?? $form_state->get('entity_form_steps_current_step') ?? NULL;
    $total   = $info['total_steps']  ?? $form_state->get('entity_form_steps_total_steps') ?? NULL;

    if (isset($form['actions']['submit']) && $current && $total && $current < $total) {
      $form['actions']['submit']['#access'] = FALSE;
    }
  }
}



function armazens_theme_theme_suggestions_alter(array &$suggestions, array $variables, $hook) {
  if ($hook == 'form' & !empty($variables['element']['#id'])) {
    $suggestions[] = 'form__' . str_replace('-', '_', $variables['element']['#id']);
  }
}

function armazens_theme_theme_suggestions_input_alter(&$suggestions, array $variables) {

  if($variables['element']['#type'] == 'submit') {
    $id = $variables['element']['#id'];

    $classes = $variables['element']['#attributes']['class'];

    if (in_array("multiple-fields-remove-button", $classes) || in_array("remove-button", $classes) ) {
      $suggestions[] = 'input__remove_button';
    }
  }
}


function armazens_theme_preprocess_page_title(&$variables) {

  switch($variables['route_name'] ) {
    case 'user.login' : 
      $variables['title'] = 'login';
      break;

    case 'user.register' : 
      $variables['title'] = 'registo';
      break;
      
    case 'entity.user.canonical' : 
      $variables['title'] = 'dashboard';
      break;
  }

}

function armazens_theme_theme_suggestions_user_alter(array &$suggestions, array $variables) {

  // Define the view mode.
  $view_mode = strtr($variables['elements']['#view_mode'], '.', '_');

  // Create a theme hook suggestion which has the view mode name in it.
  $suggestions[] = 'user__' . $view_mode;
    
  // Get current user.
  $current_user = $variables['elements']['#user'];

  // Get current user's roles.
  $roles = $current_user->getRoles();

  // Add suggestion per role.
  foreach ($roles as $role) {
    $suggestions[] = 'user__' . $view_mode . '__' . $role;
  }
}

function armazens_theme_form_views_exposed_form_alter(&$form, \Drupal\Core\Form\FormStateInterface $form_state, $form_id) {

  if($form['#id'] == 'views-exposed-form-armazens-page-gestao-armazens') {
    $form['field_nome_value']['#options'] = array();
   
    $userStorage = \Drupal::entityTypeManager()->getStorage('user');

    $query = $userStorage->getQuery();
    $uids = $query
      ->condition('status', '1')
      ->accessCheck(FALSE)
      ->condition('roles', 'utilizador')
      ->execute();

    $users = $userStorage->loadMultiple($uids);

    $form['field_nome_value']['#options'][""] = '- Qualquer -';

    foreach ($users as $user) {
      $nome = $user->get('field_nome')->getString();

      $form['field_nome_value']['#options'][$nome] = $nome;

    }

  }

}


function armazens_theme_preprocess_node(&$variables){

  if($variables['node']->getType() == "armazem") {
    if(\Drupal::currentUser()->isAnonymous() && !in_array($variables['view_mode'], ['teaser', 'map_popup'])) {

      throw new \Symfony\Component\HttpKernel\Exception\AccessDeniedHttpException();
      exit(0);
    }

    $uid = \Drupal::currentUser()->id();
    $author_id = $variables['node']->getOwner()->id();
    if ($author_id == $uid) {
      $variables['is_author'] = TRUE;
    }
    else {
      $variables['is_author'] = FALSE;
    }
  }
}