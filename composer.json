{
    "name": "drupal/recommended-project",
    "description": "Project template for Drupal projects with a relocated document root",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "homepage": "https://www.drupal.org/project/drupal",
    "support": {
        "docs": "https://www.drupal.org/docs/user_guide/en/index.html",
        "chat": "https://www.drupal.org/node/314178"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        },
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ],
    "require": {
        "composer/installers": "^2.0",
        "cweagans/composer-patches": "^1.7",
        "dompdf/dompdf": "^3.1",
        "drupal/address": "^2.0",
        "drupal/admin_toolbar": "^3.4",
        "drupal/advanced_language_selector": "^1.3",
        "drupal/bat": "^10.1@RC",
        "drupal/bat_api": "^3.1",
        "drupal/bef_select": "1.0.x-dev@dev",
        "drupal/better_exposed_filters": "^6.0",
        "drupal/block_exclude_pages": "^2.1@beta",
        "drupal/color_field": "^3.0",
        "drupal/commerce": "^2.38",
        "drupal/conditional_fields": "^4.0@alpha",
        "drupal/config_ignore": "^3.4",
        "drupal/core-composer-scaffold": "^10.5.1",
        "drupal/core-project-message": "^10.5.1",
        "drupal/core-recommended": "^10.5.1",
        "drupal/datetime_flatpickr": "^3.0",
        "drupal/dropzonejs": "^2.8",
        "drupal/email_registration": "^1.4",
        "drupal/entity_browser": "^2.9",
        "drupal/entity_form_field_label": "^2.0",
        "drupal/entity_form_steps": "^1.1",
        "drupal/field_group": "^4.0",
        "drupal/field_hidden": "^2.1",
        "drupal/formdazzle": "^3.0",
        "drupal/forms_steps": "1.x-dev@dev",
        "drupal/geocoder": "^4.29",
        "drupal/geolocation": "^3.12",
        "drupal/google_analytics": "^4.0",
        "drupal/honeypot": "2.1.x-dev@dev",
        "drupal/inline_entity_form": "^1.1",
        "drupal/ip_language_negotiation": "^1.3",
        "drupal/language_switcher_langcode": "^2.1",
        "drupal/leaflet": "^10.3",
        "drupal/leaflet_more_maps": "^2.2",
        "drupal/legal": "^3.0",
        "drupal/mailchimp": "^2.2",
        "drupal/menu_per_role": "^1.5",
        "drupal/menus_attribute": "^1.3",
        "drupal/message": "^1.8",
        "drupal/message_notify": "^1.5",
        "drupal/metatag": "^2.0",
        "drupal/mimemail": "^1.0@alpha",
        "drupal/multiple_fields_remove_button": "^2.2",
        "drupal/node_view_permissions": "^1.6",
        "drupal/office_hours": "^1.17",
        "drupal/paragraphs": "^1.16",
        "drupal/paragraphs_ee": "^10.0",
        "drupal/paragraphs_features": "^2.0@beta",
        "drupal/pathauto": "^1.12",
        "drupal/phone_international": "^3.3",
        "drupal/recaptcha": "^3.4",
        "drupal/recaptcha_v3": "^2.0",
        "drupal/redirect": "^1.12",
        "drupal/registration_role": "^2.0",
        "drupal/reroute_email": "^2.2",
        "drupal/select_or_other": "^4.1",
        "drupal/seo_checklist": "^5.2",
        "drupal/shield": "^1.7",
        "drupal/show_email": "^1.2",
        "drupal/simple_menu_icons": "^3.0",
        "drupal/simple_open_hours": "^1.0@beta",
        "drupal/simple_password_policy": "^1.0",
        "drupal/simple_sitemap": "^4.2",
        "drupal/smtp": "^1.4",
        "drupal/subpathauto": "^1.3",
        "drupal/svg_image": "^3.0",
        "drupal/symfony_mailer": "^1.4",
        "drupal/telephone_validation": "^2.4",
        "drupal/terms_of_use": "^2.3",
        "drupal/twig_tweak": "^3.2",
        "drupal/user_registrationpassword": "^2.0",
        "drupal/verf": "^2.0",
        "drupal/view_unpublished": "^1.1",
        "drupal/views_infinite_scroll": "^2.0",
        "drupal/webform": "^6.2",
        "drupal/wpf": "^1.2",
        "drush/drush": "^12.3",
        "enyo/dropzone": "^5.7",
        "geocoder-php/google-maps-provider": "^4.8",
        "geocoder-php/here-provider": "^0.8.0",
        "geocoder-php/nominatim-provider": "^5.8",
        "geocoder-php/photon-provider": "^0.10.0",
        "mglaman/composer-drupal-lenient": "^1.0",
        "npm-asset/intl-tel-input": "^17.0",
        "oomphinc/composer-installers-extender": "^2.0",
        "wikimedia/composer-merge-plugin": "^2.1"
    },
    "conflict": {
        "drupal/drupal": "*"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "drupal/core-composer-scaffold": true,
            "drupal/core-project-message": true,
            "phpstan/extension-installer": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "oomphinc/composer-installers-extender": true,
            "cweagans/composer-patches": true,
            "mglaman/composer-drupal-lenient": true,
            "php-http/discovery": true,
            "wikimedia/composer-merge-plugin": true
        },
        "sort-packages": true
    },
    "extra": {
        "drupal-scaffold": {
            "locations": {
                "web-root": "web/"
            }
        },
        "installer-types": [
            "npm-asset",
            "bower-asset"
        ],
        "merge-plugin": {
            "include": [
                "web/modules/contrib/dropzonejs/composer.libraries.json"
            ]
        },
        "installer-paths": {
            "web/core": [
                "type:drupal-core"
            ],
            "web/libraries/{$name}": [
                "type:drupal-library",
                "type:npm-asset",
                "type:bower-asset"
            ],
            "web/modules/contrib/{$name}": [
                "type:drupal-module"
            ],
            "web/profiles/contrib/{$name}": [
                "type:drupal-profile"
            ],
            "web/themes/contrib/{$name}": [
                "type:drupal-theme"
            ],
            "drush/Commands/contrib/{$name}": [
                "type:drupal-drush"
            ],
            "web/modules/custom/{$name}": [
                "type:drupal-custom-module"
            ],
            "web/profiles/custom/{$name}": [
                "type:drupal-custom-profile"
            ],
            "web/themes/custom/{$name}": [
                "type:drupal-custom-theme"
            ]
        },
        "drupal-core-project-message": {
            "include-keys": [
                "homepage",
                "support"
            ],
            "post-create-project-cmd-message": [
                "<bg=blue;fg=white>                                                         </>",
                "<bg=blue;fg=white>  Congratulations, you’ve installed the Drupal codebase  </>",
                "<bg=blue;fg=white>  from the drupal/recommended-project template!          </>",
                "<bg=blue;fg=white>                                                         </>",
                "",
                "<bg=yellow;fg=black>Next steps</>:",
                "  * Install the site: https://www.drupal.org/docs/installing-drupal",
                "  * Read the user guide: https://www.drupal.org/docs/user_guide/en/index.html",
                "  * Get support: https://www.drupal.org/support",
                "  * Get involved with the Drupal community:",
                "      https://www.drupal.org/getting-involved",
                "  * Remove the plugin that prints this message:",
                "      composer remove drupal/core-project-message"
            ]
        },
        "enable-patching": true,
        "patches": {
            "drupal/core": {
                "fix": "https://www.drupal.org/files/issues/2022-12-24/3328962-5.patch"
            },
            "drupal/address": {
                "fix": "https://www.drupal.org/files/issues/2024-03-29/3412241-30-Mismatched-field-definitions-after-address-upgrade.patch"
            },
            "drupal/multiple_fields_remove_button": {
                "entity_reference_revisions_support": "web/patches/entity_reference_revisions_support.patch"
            },
            "drupal/entity_browser": {
                "multi_step_selection_with_automatic_select": "https://www.drupal.org/files/issues/2019-09-06/multi_step_selection_with_automatic_select_2853751_14.patch",
                "fix_auto_select_timing": "web/patches/entity_browser_auto_select_fix.patch"
            },
            "drupal/simple_menu_icons": {
                "simple_menu_icons-no_icons": "https://www.drupal.org/files/issues/2023-06-22/simple_menu_icons-no_icons-3026947-17.patch"
            },
            "drupal/terms_of_use": {
                "html_in_validation_2772483_06": "https://www.drupal.org/files/issues/2022-11-08/terms_of_use.html_in_validation_2772483_06.patch",
                "add_terms_to_acount": "web/patches/add_terms_to_acount.patch"
            },
            "drupal/mimemail": {
                "3354721": "https://www.drupal.org/files/issues/2023-07-10/3354721.patch"
            },
            "drupal/bat": {
                "bat_event_correction": "web/patches/bat_event_correction.patch"
            },
            "drupal/menus_attribute": {
                "fix_menus_attribute_render_bug": "https://www.drupal.org/files/issues/2023-06-06/fix_menus_attribute_render_bug.patch"
            }
        },
        "drupal-lenient": {
            "allowed-list": [
                "drupal/forms_steps"
            ]
        }
    },
    "require-dev": {
        "drupal/devel": "^5.3",
        "drupal/masquerade": "^2.0"
    }
}
