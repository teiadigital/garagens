{#
/**
 * @file
 * Template para a página de gestão de garagens (gestor).
 */
#}
<div class="w-full">

  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold text-gray-900">{{ 'Garagens'|t }}</h1>
    {% if view.total_rows %}
      <span class="text-xs text-gray-400">{{ view.total_rows }} {{ 'garagens'|t }}</span>
    {% endif %}
  </div>

  {% if exposed %}
    <div class="flex flex-wrap gap-3 mb-6">
      {{ exposed }}
    </div>
  {% endif %}

  {% if rows %}
    {{ rows }}
  {% elseif empty %}
    <div class="flex flex-col items-center justify-center py-16 text-center">
      <div class="w-14 h-14 rounded-full bg-gray-100 flex items-center justify-center mb-4">
        <svg class="w-6 h-6 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
        </svg>
      </div>
      <p class="text-sm font-medium text-gray-500">{{ 'Sem garagens'|t }}</p>
    </div>
  {% endif %}

  {% if pager %}
    <div class="mt-6">{{ pager }}</div>
  {% endif %}

</div>
