{#
/**
* @file
* Theme override for a 'form' element.
*
* Available variables
* - attributes: A list of HTML attributes for the wrapper element.
* - children: The child elements of the form.
*
* @see template_preprocess_form()
*/
#}

<div class="lg:max-w-2xl">
    
    <form{{ attributes }}>
        {{ children }}
    </form>

    <div class="mt-10">
        <p class="text-sm text-center sm:text-start text-black">{{ "Don't have an account?"|t }} <a
                class="font-bold leading-6 text-black underline " href="{{path('user.register')}}">{{ " Sign up here."|t }}</a> </p>
    </div>

</div>
