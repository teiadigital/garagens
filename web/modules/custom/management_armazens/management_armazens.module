<?php

use Drupal\Core\Form\FormStateInterface;

/**
 * @file
 * Primary module hooks for management armazem module.
 */

function management_armazens_theme($existing, $type, $theme, $path) {
  $module_path = \Drupal::service('extension.list.module')->getPath('management_armazens');

  return [
    'info_details_user' => ['variables' => ['data' => []]],
    'info_details_user_dashboard' => ['variables' => ['data' => []]],
    'actions_armazens' => [
      'variables' => ['data' => NULL, 'form' => NULL],
      'template' => 'actions-armazens',
      'path' => $module_path . '/templates',
    ],
  ];
}

function management_armazens_preprocess_block(&$variables) {
  if ($variables['plugin_id'] == "local_actions_block") {
    $variables['elements']['#cache']['max-age'] = 0;
    $variables['#cache']['max-age'] = 0;
  }
}

function management_armazens_options_list_alter(array &$options, array $context) {
  unset($options['_none']);
}

/**
 * Implements hook_form_alter().
 */
function management_armazens_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  // View exposed filter (mapa).
  if ($form_id == 'views_exposed_form' && ($form['#id'] ?? '') === 'views-exposed-form-armazens-page-armazens') {
    $country = $form_state->getUserInput()['field_localidade_country_code'] ?? NULL;
    $administrative_area = $form_state->getUserInput()['field_localidade_administrative_area'] ?? NULL;

    if ($country && $country !== 'All') {
      $address = ($administrative_area && $administrative_area !== 'All') ? ($administrative_area . ', ' . $country) : $country;
      $api_key = '65e051e8653e3622949358ujic3da8d';
      $url     = "https://geocode.maps.co/search?q=" . urlencode($address) . "&api_key=" . $api_key;

      $json = @file_get_contents($url);
      $json = $json ? json_decode($json) : NULL;

      if ($json && !empty($json[0])) {
        $html = '<div style="display: none;" id="cc_map_lon">' . $json[0]->lon . '</div>'
          . '<div style="display: none;" id="cc_map_lat">' . $json[0]->lat . '</div>';
        $form['mymarkup'] = ['#markup' => $html];
      }
    }
  }

  // Node pedidos.
  if ($form_id == 'node_pedidos_form') {
    if (isset($form['title']['widget'][0]['value']['#default_value']) && $form['title']['widget'][0]['value']['#default_value'] === NULL) {
      $form['title']['widget'][0]['value']['#default_value'] = 'initial';
    }
  }

  // Node armazem.
  if ($form_id == 'node_armazem_form' || $form_id == 'node_armazem_edit_form') {
    if (isset($form['title']['widget'][0]['value']['#default_value']) && $form['title']['widget'][0]['value']['#default_value'] === NULL) {
      $form['title']['widget'][0]['value']['#default_value'] = 'initial';
    }
    if (isset($form['field_fotos'])) {
      $form['field_fotos']['widget']['#type'] = 'fieldset';
    }
  }
}

/**
 * Implements hook_form_node_form_alter().
 */
function management_armazens_form_node_form_alter(array &$form, FormStateInterface $form_state) {
  $entity = $form_state->getFormObject() ? $form_state->getFormObject()->getEntity() : NULL;
  
  if (!$entity || $entity->getEntityTypeId() !== 'node' || $entity->bundle() !== 'armazem') {
    return;
  }

  // Título mínimo no "add".
  if ($entity->isNew() && ($entity->getTitle() === '' || $entity->getTitle() === NULL)) {
    $entity->setTitle('initial');
  }
  if (isset($form['title']['widget'][0]['value'])) {
    $title_el = &$form['title']['widget'][0]['value'];
    if (empty($title_el['#default_value']) && empty($title_el['#value'])) {
      $title_el['#default_value'] = 'initial';
    }
  }

  // Validação do código postal.
  if (isset($form['field_localidade'])) {
    $form['#validate'][] = 'management_armazens_validate_postal_code';
  }

  // Ao submeter o form, estado 0 (aguardar aprovação).
  $form['actions']['submit']['#submit'][] = 'management_armazens_finish_submit';

}

/**
 * Submit handler: estado 0 (aguardar aprovação), unpublished.
 */
function management_armazens_finish_submit(array &$form, FormStateInterface $form_state) {
  /** @var \Drupal\node\NodeInterface $entity */
  $entity = $form_state->getFormObject()->getEntity();

  try {
    if (!$entity->hasField('field_estado')) {
      return;
    }
    $entity->set('field_estado', 0);
    $entity->setUnpublished();
    $entity->save();
  }
  catch (\Throwable $t) {
    \Drupal::logger('management_armazens')->error('Finish save failed: @m', ['@m' => $t->getMessage()]);
  }

  management_armazens_send_email($form, $form_state);
  management_armazens_send_email_gestor($form, $form_state);
}

/**
 * Implements hook_entity_presave().
 */
function management_armazens_entity_presave(Drupal\Core\Entity\EntityInterface $entity) {
  if ($entity->getEntityTypeId() !== 'node') {
    return;
  }

  if ($entity->bundle() == 'armazem') {
    $original_title = $entity->getTitle();
    if ($original_title == "initial") {
      $country_code = $entity->get('field_localidade')->getValue()[0]['country_code'] ?? '';
      $ano = date('y');
      $mes = date('m');

      $query = \Drupal::entityQuery('node');
      $query->accessCheck(FALSE)
        ->condition('type', 'armazem')
        ->condition('field_localidade.country_code', $country_code)
        ->condition('created', strtotime("$ano-$mes-01"), '>=')
        ->condition('created', strtotime("$ano-$mes-01 +1 month"), '<')
        ->sort('created', 'DESC')
        ->range(0, 1);

      $nids = $query->execute();
      $nodes = \Drupal::entityTypeManager()->getStorage('node')->loadMultiple($nids);
      $latest_node = reset($nodes);

      if ($latest_node) {
        $title = $latest_node->label();
        $newstring = substr($title, -4);
        if (is_numeric($newstring)) {
          $inc = (int) $newstring + 1;
          $formatted = sprintf('%04d', $inc);
          $final = $country_code . $ano . $mes . $formatted;
        }
        else {
          $final = $country_code . $ano . $mes . '0001';
        }
      }
      else {
        $final = $country_code . $ano . $mes . '0001';
      }

      $entity->setTitle($final);
    }
  }

  if ($entity->bundle() == 'pedidos') {
    $original_title = $entity->getTitle();

    if ($original_title == "initial") {
      $ano = date('y');
      $mes = date('m');

      $query = \Drupal::entityQuery('node');
      $query->accessCheck(FALSE)
        ->condition('type', 'pedidos')
        ->condition('created', strtotime("$ano-$mes-01"), '>=')
        ->condition('created', strtotime("$ano-$mes-01 +1 month"), '<')
        ->sort('created', 'DESC')
        ->range(0, 1);

      $nids = $query->execute();
      $nodes = \Drupal::entityTypeManager()->getStorage('node')->loadMultiple($nids);
      $latest_node = reset($nodes);

      if ($latest_node) {
        $title = $latest_node->label();
        $newstring = substr($title, -4);
        if (is_numeric($newstring)) {
          $inc = (int) $newstring + 1;
          $formatted = sprintf('%04d', $inc);
          $final = 'REQ' . $ano . $mes . $formatted;
        } else {
          $final = 'REQ' . $ano . $mes . '0001';
        }
      } else {
        $final = 'REQ' . $ano . $mes . '0001';
      }

      $entity->setTitle($final);
    }
  }

  if ($entity->isNew() && $entity->hasField('field_estado')) {
    $estado = $entity->get('field_estado')->value ?? NULL;
    if ($estado === NULL || $estado === '') {
      $entity->set('field_estado', -1);
      $entity->setUnpublished();
    }
    if ($estado == 0 || $estado == -1) {
      $entity->setUnpublished();
    }
  }
}

function management_armazens_save_coordinates_address(array $form, FormStateInterface $form_state) {
  $node = $form_state->getFormObject()->getEntity();

  $postal_code  = $node->get('field_localidade')->getValue()[0]['postal_code']  ?? '';
  $country_code = $node->get('field_localidade')->getValue()[0]['country_code'] ?? '';

  if ($postal_code && $country_code) {
    $url  = "http://api.geonames.org/postalCodeLookupJSON?postalcode={$postal_code}&country={$country_code}&username=teiadigital";
    $json = @file_get_contents($url);
    $json = $json ? json_decode($json) : NULL;

    if ($json && !empty($json->postalcodes[0])) {
      $coordenadas = $json->postalcodes[0]->lat . ',' . $json->postalcodes[0]->lng;
      $node->set('field_coordenadas', $coordenadas);
      $node->save();
    }
  }
}

function management_armazens_send_email(array $form, FormStateInterface $form_state) {
  $node = $form_state->getFormObject()->getEntity();
  $node->set('field_estado', 0);
  $node->setUnpublished();
  $node->save();

  $user_email = \Drupal::currentUser()->getEmail();

  $mailManager = \Drupal::service('plugin.manager.mail');
  $module = 'management_armazens';
  $key = 'general_mail';
  $to = $user_email;
  $params['subject'] = t("Your garage has been successfully created.");
  $params['body'] = t("Thank you for using the platform. <br>"
    . "In the next few hours you will receive a notification confirming the publication or requesting any rectifications. <br>"
    . "See you soon!");

  $langcode = \Drupal::currentUser()->getPreferredLangcode();
  $send = TRUE;
  $result = $mailManager->mail($module, $key, $to, $langcode, $params, NULL, $send);

  if (empty($result['result'])) {
    \Drupal::messenger()->addError(t('There was a problem sending your message and it was not sent.'), 'error');
  }
}

function management_armazens_send_email_gestor(array $form, FormStateInterface $form_state) {
  $node = $form_state->getFormObject()->getEntity();
  $title = $node->getTitle();

  $user_storage = \Drupal::entityTypeManager()->getStorage('user');
  $user_ids = $user_storage->getQuery()
    ->condition('status', 1)
    ->accessCheck(FALSE)
    ->condition('roles', 'gestor')
    ->execute();

  $users = $user_storage->loadMultiple($user_ids);

  $mailManager = \Drupal::service('plugin.manager.mail');
  $module = 'management_armazens';
  $key = 'general_mail';
  $params['subject'] = t("Foi criada uma nova garagem na plataforma.");
  $params['body'] = t("Foi criada uma nova garagem @title na plataforma.", ['@title' => $title]);

  $send = TRUE;

  foreach ($users as $user) {
    $to = $user->getEmail();
    $langcode = $user->getPreferredLangcode();
    $result = $mailManager->mail($module, $key, $to, $langcode, $params, NULL, $send);
    if (empty($result['result'])) {
      \Drupal::messenger()->addError(t('There was a problem sending your message and it was not sent.'), 'error');
    }
  }
}

function management_armazens_mail($key, &$message, $params) {
  switch ($key) {
    case 'general_mail':
      $site_mail = \Drupal::config('system.site')->get('mail') ?: 'no-reply@' . \Drupal::request()->getHost();
      $message['from'] = $site_mail;
      $message['subject'] = preg_replace("/[\r\n]+/", ' ', $params['subject']);
      $message['body'][] = $params['body'];
      break;
  }
}

function management_armazens_theme_suggestions_input_alter(&$suggestions, array $variables) {
  if (($variables['element']['#type'] ?? '') === 'submit') {
    $classes = $variables['element']['#attributes']['class'] ?? [];
    if (in_array('remove-button', $classes, TRUE)) {
      $suggestions[] = 'input__remove_button';
    }
  }
}

function management_armazens_preprocess_links(&$variables) {
  $variables['current_language'] = \Drupal::languageManager()->getCurrentLanguage()->getId();
}

function management_armazens_validate_postal_code(array &$form, FormStateInterface $form_state): void {
  $address = $form_state->getValue(['field_localidade', 0, 'address']);
  if (!is_array($address)) {
    return;
  }

  $postal_code  = trim($address['postal_code'] ?? '');
  $country_code = strtoupper(trim($address['country_code'] ?? ''));

  if ($postal_code === '' || $country_code === '') {
    return;
  }

  /** @var \CommerceGuys\Addressing\AddressFormat\AddressFormatRepositoryInterface $repo */
  $repo = \Drupal::service('address.address_format_repository');
  $format = $repo->get($country_code);
  $pattern = $format ? $format->getPostalCodePattern() : null;

  if ($pattern) {
    $regex = '/^' . $pattern . '$/u';
    if (!preg_match($regex, $postal_code)) {
      if (isset($form['field_localidade']['widget'][0]['address']['postal_code'])) {
        $form_state->setError(
          $form['field_localidade']['widget'][0]['address']['postal_code'],
          t('Formato de código-postal inválido para @country.', ['@country' => $country_code])
        );
      } else {
        $form_state->setErrorByName('field_localidade][0][address][postal_code', t('Formato de código-postal inválido.'));
      }
      return;
    }
  }

  try {
    $client = \Drupal::httpClient();
    $res = $client->get('http://api.geonames.org/postalCodeLookupJSON', [
      'query' => [
        'postalcode' => $postal_code,
        'country'    => $country_code,
        'username'   => 'teiadigital',
      ],
      'timeout' => 5,
    ]);
    $json = json_decode((string) $res->getBody(), true);
    if (empty($json['postalcodes'])) {
      if (isset($form['field_localidade']['widget'][0]['address']['postal_code'])) {
        $form_state->setError(
          $form['field_localidade']['widget'][0]['address']['postal_code'],
          t('O código-postal não foi encontrado.')
        );
      } else {
        $form_state->setErrorByName('field_localidade][0][address][postal_code', t('O código-postal não foi encontrado.'));
      }
    }
  } catch (\Exception $e) {
    return;
  }
}

function management_armazens_module_implements_alter(array &$implementations, $hook) {
  if ($hook === 'form_alter' || $hook === 'form_node_form_alter') {
    if (isset($implementations['management_armazens'])) {
      $ours = $implementations['management_armazens'];
      unset($implementations['management_armazens']);
      $implementations['management_armazens'] = $ours;
    }
  }
}
