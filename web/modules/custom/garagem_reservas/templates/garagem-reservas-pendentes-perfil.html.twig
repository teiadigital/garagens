{#
/**
 * @file
 * Reservas pendentes de aceitação no perfil do arrendatário.
 */
#}

{% import '@garagem_reservas/_estados.html.twig' as estados %}

{% if items is not empty %}
<div class="mb-8 pb-8 border-b border-gray-100">

  <div class="flex items-center gap-2 mb-4">
    <div class="w-2 h-2 rounded-full bg-yellow-400"></div>
    <h2 class="text-lg font-semibold text-gray-900">{{ 'Reservas a aguardar resposta'|t }}</h2>
    <span class="ml-1 px-2 py-0.5 bg-yellow-100 text-yellow-700 rounded-full text-xs font-bold">{{ items|length }}</span>
  </div>

  <div class="space-y-3 w-full">
    {% for item in items %}
      <div class="w-full rounded-2xl overflow-hidden hover:shadow-xl hover:-translate-y-0.5 hover:border-gray-300 transition-all duration-200 relative"
           style="background:#fff; border:1px solid #e5e7eb">

        <a href="{{ item.url_reserva }}"
           class="absolute inset-0 z-0" aria-label="{{ item.titulo }}"></a>

        <div class="flex flex-col sm:flex-row relative z-10 pointer-events-none">

          {# ── FOTO / PAINEL ── #}
          <div class="relative flex-shrink-0 h-36 sm:h-auto sm:w-40 overflow-hidden bg-gray-100">
            {% if item.foto_url %}
              <img src="{{ item.foto_url }}" alt="{{ item.titulo }}"
                   class="absolute inset-0 w-full h-full object-cover">
            {% endif %}
          </div>

          {# ── CONTEÚDO + BOTÃO ── #}
          <div class="flex-1 flex min-w-0">

            <div class="flex-1 flex flex-col justify-center px-4 py-3 sm:px-5 sm:py-4 min-w-0">

              <p class="font-bold text-gray-900 text-base sm:text-lg leading-tight truncate">{{ item.titulo }}</p>
              {% if item.localidade %}
                <p class="text-xs sm:text-sm mt-0.5 flex items-center gap-1" style="color:#888">
                  <svg class="w-3 h-3 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"/>
                  </svg>
                  {{ item.localidade }}
                </p>
              {% endif %}

              <div class="flex flex-wrap items-center gap-2 my-3">
                <span class="text-sm font-semibold px-3 py-1.5 rounded-lg" style="background:#f3f4f6; color:#111827">
                  {{ item.data_inicio }}
                </span>
                <svg class="w-4 h-4 flex-shrink-0 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                </svg>
                <span class="text-sm font-semibold px-3 py-1.5 rounded-lg" style="background:#f3f4f6; color:#111827">
                  {{ item.data_fim }}
                </span>
              </div>

              <div class="mb-2">
                {{ estados.pill(item.estado, 'user') }}
              </div>

            </div>

            <div class="hidden sm:flex flex-shrink-0 items-center justify-center px-4">
              <a href="{{ item.url_reserva }}"
                 class="inline-flex items-center justify-center gap-1.5 text-sm font-bold px-4 py-2.5 rounded-xl transition hover:opacity-80 whitespace-nowrap pointer-events-auto"
                 style="background:#111827 !important; color:#fff !important">
                {{ 'Ver detalhes'|t }}
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
              </a>
            </div>

          </div>
        </div>

        <div class="sm:hidden px-4 pb-4 relative z-10 pointer-events-auto">
          <a href="{{ item.url_reserva }}"
             class="flex items-center justify-center gap-1.5 text-sm font-bold w-full py-2.5 rounded-xl transition hover:opacity-80"
             style="background:#111827 !important; color:#fff !important">
            {{ 'Ver detalhes'|t }}
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </a>
        </div>

      </div>
    {% endfor %}
  </div>

</div>
{% endif %}
