<?php

/**
 * @file
 * Install, update, and uninstall functions for garagem_reservas module.
 */

/**
 * Implements hook_schema().
 */
function garagem_reservas_schema() {
  $schema['garagem_reserva'] = [
    'description' => 'Tabela de reservas de garagens.',
    'fields' => [
      'id' => ['type' => 'serial', 'unsigned' => TRUE, 'not null' => TRUE],
      'garagem_id' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'user_id' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'proprietario_id' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'data_inicio' => ['type' => 'int', 'not null' => TRUE],
      'data_fim' => ['type' => 'int', 'not null' => FALSE],
      'renovacao_automatica' => ['type' => 'int', 'size' => 'tiny', 'not null' => TRUE, 'default' => 0],
      'tipo_preco' => ['type' => 'varchar', 'length' => 10, 'not null' => TRUE],
      'preco_total' => ['type' => 'numeric', 'precision' => 10, 'scale' => 2, 'not null' => TRUE],
      'taxa_plataforma' => ['type' => 'numeric', 'precision' => 10, 'scale' => 2, 'not null' => TRUE],
      'estado' => ['type' => 'varchar', 'length' => 20, 'not null' => TRUE, 'default' => 'pendente'],
      'data_criacao' => ['type' => 'int', 'not null' => TRUE],
      'data_aprovacao' => ['type' => 'int', 'not null' => FALSE],
      'data_pagamento' => ['type' => 'int', 'not null' => FALSE],
      'commerce_order_id' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE],
      'notas' => ['type' => 'text', 'not null' => FALSE],
      'review_email_enviado' => ['type' => 'int', 'size' => 'tiny', 'not null' => TRUE, 'default' => 0],
    ],
    'primary key' => ['id'],
    'indexes' => [
      'garagem_id' => ['garagem_id'],
      'user_id' => ['user_id'],
      'estado' => ['estado'],
    ],
  ];

  $schema['garagem_indisponibilidade'] = [
    'description' => 'Datas bloqueadas manualmente pelo proprietário.',
    'fields' => [
      'id' => ['type' => 'serial', 'unsigned' => TRUE, 'not null' => TRUE],
      'garagem_id' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'data_inicio' => ['type' => 'int', 'not null' => TRUE],
      'data_fim' => ['type' => 'int', 'not null' => TRUE],
      'data_criacao' => ['type' => 'int', 'not null' => TRUE],
    ],
    'primary key' => ['id'],
    'indexes' => [
      'garagem_id' => ['garagem_id'],
    ],
  ];

  $schema['garagem_review'] = [
    'description' => 'Reviews de garagens por arrendatários.',
    'fields' => [
      'id' => ['type' => 'serial', 'unsigned' => TRUE, 'not null' => TRUE],
      'garagem_id' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'user_id' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'reserva_id' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE],
      'rating' => ['type' => 'int', 'size' => 'tiny', 'unsigned' => TRUE, 'not null' => TRUE],
      'texto' => ['type' => 'text', 'not null' => FALSE],
      'created' => ['type' => 'int', 'not null' => TRUE],
    ],
    'primary key' => ['id'],
    'indexes' => [
      'garagem_id' => ['garagem_id'],
      'user_id' => ['user_id'],
    ],
  ];

  return $schema;
}

/**
 * Adicionar tabela garagem_indisponibilidade.
 */
function garagem_reservas_update_8001() {
  $schema = \Drupal::database()->schema();
  if (!$schema->tableExists('garagem_indisponibilidade')) {
    $spec = [
      'description' => 'Datas bloqueadas manualmente pelo proprietário.',
      'fields' => [
        'id' => ['type' => 'serial', 'unsigned' => TRUE, 'not null' => TRUE],
        'garagem_id' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
        'data_inicio' => ['type' => 'int', 'not null' => TRUE],
        'data_fim' => ['type' => 'int', 'not null' => TRUE],
        'data_criacao' => ['type' => 'int', 'not null' => TRUE],
      ],
      'primary key' => ['id'],
      'indexes' => ['garagem_id' => ['garagem_id']],
    ];
    $schema->createTable('garagem_indisponibilidade', $spec);
  }
}

/**
 * Substituir coluna indefinido por renovacao_automatica.
 */
function garagem_reservas_update_8002() {
  $schema = \Drupal::database()->schema();
  $database = \Drupal::database();

  if (!$schema->fieldExists('garagem_reserva', 'renovacao_automatica')) {
    $schema->addField('garagem_reserva', 'renovacao_automatica', [
      'type' => 'int',
      'size' => 'tiny',
      'not null' => TRUE,
      'default' => 0,
    ]);
    $database->query("UPDATE {garagem_reserva} SET renovacao_automatica = indefinido");
  }

  if ($schema->fieldExists('garagem_reserva', 'indefinido')) {
    $schema->dropField('garagem_reserva', 'indefinido');
  }
}

/**
 * Atualizar templates de notificação com placeholder @garagem.
 */
function garagem_reservas_update_8003() {
  $templates = [
    'reserva_criada_proprietario' => '<p>Foi feito um novo pedido de reserva para a sua garagem <strong>@garagem</strong>. Aceda à plataforma para aprovar ou rejeitar.</p>',
    'reserva_criada_user' => '<p>O seu pedido de reserva para <strong>@garagem</strong> foi submetido com sucesso. Aguarde a aprovação do proprietário.</p>',
    'reserva_aprovada_user' => '<p>A sua reserva para <strong>@garagem</strong> foi aprovada! Aceda à plataforma para efetuar o pagamento dentro do prazo.</p>',
    'reserva_aguarda_pagamento_user' => '<p>O seu processo de pagamento para <strong>@garagem</strong> foi iniciado. Por favor conclua o pagamento para confirmar a reserva.</p>',
    'reserva_rejeitada_user' => '<p>A sua reserva para <strong>@garagem</strong> não foi aceite pelo proprietário.</p>',
    'reserva_paga_proprietario' => '<p>O pagamento da reserva da garagem <strong>@garagem</strong> foi confirmado. Aceda à plataforma para ver os detalhes.</p>',
    'reserva_paga_user' => '<p>O seu pagamento para <strong>@garagem</strong> foi confirmado. A sua reserva está ativa!</p>',
    'reserva_cancelada_proprietario' => '<p>O arrendatário cancelou a reserva da garagem <strong>@garagem</strong>.</p>',
    'reserva_cancelada_user_confirmacao' => '<p>A sua reserva para <strong>@garagem</strong> foi cancelada com sucesso.</p>',
    'reserva_cancelada_pelo_proprietario_user' => '<p>A sua reserva para <strong>@garagem</strong> foi cancelada pelo proprietário. Lamentamos o inconveniente.</p>',
    'reserva_cancelada_proprietario_confirmacao' => '<p>A reserva da garagem <strong>@garagem</strong> foi cancelada com sucesso.</p>',
    'reserva_expirada' => '<p>A sua reserva para <strong>@garagem</strong> expirou por não ter sido concluído o pagamento dentro do prazo.</p>',
    'reserva_expirada_proprietario' => '<p>Uma reserva para <strong>@garagem</strong> expirou por falta de pagamento. A garagem voltou a ficar disponível.</p>',
  ];

  $config_factory = \Drupal::configFactory();
  foreach ($templates as $template_id => $novo_texto) {
    $config = $config_factory->getEditable("message.template.{$template_id}");
    if (!$config->isNew()) {
      $config->set('text', [['value' => $novo_texto, 'format' => 'basic_html']]);
      $config->save();
    }
  }
}

/**
 * Adicionar campo review_email_enviado e criar template de mensagem de review.
 */
function garagem_reservas_update_8006() {
  // Adicionar coluna review_email_enviado.
  $schema = \Drupal::database()->schema();
  if (!$schema->fieldExists('garagem_reserva', 'review_email_enviado')) {
    $schema->addField('garagem_reserva', 'review_email_enviado', [
      'type' => 'int',
      'size' => 'tiny',
      'not null' => TRUE,
      'default' => 0,
      'description' => 'Se o email de convite para review já foi enviado.',
    ]);
  }

  // Criar template de mensagem para convite de review via entity API.
  $storage = \Drupal::entityTypeManager()->getStorage('message_template');
  if (!$storage->load('review_convite')) {
    $template = $storage->create([
      'template'    => 'review_convite',
      'label'       => 'Convite para avaliar garagem',
      'description' => 'Email enviado ao arrendatário após o início da estadia.',
      'text'        => [[
        'value'  => '<p>Olá! A sua estadia em <strong>@garagem</strong> já começou. Partilhe a sua experiência e ajude outros utilizadores avaliando esta garagem.</p><p><a href="@url_review">Avaliar agora →</a></p>',
        'format' => 'basic_html',
      ]],
    ]);
    $template->save();
  }
}

/**
 * Corrigir template review_convite — apagar config malformada e recriar.
 */
function garagem_reservas_update_8007() {
  $config_factory = \Drupal::configFactory();

  // Apagar config malformada criada pelo update_8006.
  $config_factory->getEditable('message.template.review_convite')->delete();

  // Recriar com estrutura correta (igual aos outros templates).
  $config_factory->getEditable('message.template.review_convite')
    ->set('langcode', 'pt')
    ->set('status', TRUE)
    ->set('id', 'review_convite')
    ->set('template', 'review_convite')
    ->set('label', 'Convite para avaliar garagem')
    ->set('description', 'Email enviado ao arrendatário após o início da estadia.')
    ->set('text', [[
      'value'  => '<p>Olá! A sua estadia em <strong>@garagem</strong> já começou. Partilhe a sua experiência e ajude outros utilizadores avaliando esta garagem.</p><p><a href="@url_review">Avaliar agora →</a></p>',
      'format' => 'basic_html',
    ]])
    ->save();
}

/**
 * Criar tabela garagem_review.
 */
function garagem_reservas_update_8005() {
  $schema = \Drupal::database()->schema();
  if (!$schema->tableExists('garagem_review')) {
    $spec = [
      'description' => 'Reviews de garagens por arrendatários.',
      'fields' => [
        'id' => ['type' => 'serial', 'unsigned' => TRUE, 'not null' => TRUE],
        'garagem_id' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
        'user_id' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
        'reserva_id' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE],
        'rating' => ['type' => 'int', 'size' => 'tiny', 'unsigned' => TRUE, 'not null' => TRUE],
        'texto' => ['type' => 'text', 'not null' => FALSE],
        'created' => ['type' => 'int', 'not null' => TRUE],
      ],
      'primary key' => ['id'],
      'indexes' => [
        'garagem_id' => ['garagem_id'],
        'user_id' => ['user_id'],
      ],
    ];
    $schema->createTable('garagem_review', $spec);
  }
}

/**
 * Adiciona coluna motivo à tabela garagem_reserva.
 */
function garagem_reservas_update_8004() {
  $schema = \Drupal::database()->schema();
  if (!$schema->fieldExists('garagem_reserva', 'motivo')) {
    $schema->addField('garagem_reserva', 'motivo', [
      'type' => 'text',
      'size' => 'medium',
      'not null' => FALSE,
      'description' => 'Motivo de cancelamento ou rejeição.',
    ]);
  }
}
