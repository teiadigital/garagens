{#
 * @file
 * Template da página de pesquisa de garagens.
 #}

<div class="min-h-screen bg-white">

  {# Barra de pesquisa #}
  <div class="border-b border-gray-100 py-6 px-4">
    <form id="pesquisa-form" class="max-w-3xl mx-auto">

      {# Container relativo — barra + painel ficam aqui dentro #}
      <div id="pesquisa-bar-container" style="position:relative;">

        {# A barra em si #}
        <div id="pesquisa-bar"
             class="flex flex-col sm:flex-row items-stretch bg-white border border-gray-200 rounded-2xl sm:rounded-full shadow-md">

          {# Onde #}
          <div style="position:relative; flex:1; min-width:0;">
            <div id="campo-onde" class="px-6 py-3 rounded-2xl sm:rounded-full hover:bg-gray-50 transition cursor-pointer h-full" style="position:relative;">
              <label class="block text-xs font-bold text-gray-900 pointer-events-none">{{ 'Onde'|t }}</label>
              <input id="pesquisa-location" type="text" autocomplete="off"
                     placeholder="{{ 'Pesquisar destinos'|t }}"
                     class="w-full border-none p-0 text-sm text-gray-500 placeholder-gray-500 focus:outline-none bg-transparent leading-5 pr-7">
              <button id="limpar-location" type="button"
                      class="hidden items-center justify-center w-5 h-5 rounded-full bg-gray-200 hover:bg-gray-300 transition"
                      style="position:absolute; right:10px; top:50%; transform:translateY(-50%);">
                <svg class="w-3 h-3 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"/>
                </svg>
              </button>
            </div>
            <div id="pesquisa-autocomplete"
                 class="hidden"
                 style="position:absolute;top:calc(100% + 8px);left:0;min-width:280px;width:100%;background:#fff;border:1px solid #e5e7eb;border-radius:20px;box-shadow:0 8px 32px rgba(0,0,0,0.12);z-index:9999;overflow:hidden;">
            </div>
            <input type="hidden" id="pesquisa-lat">
            <input type="hidden" id="pesquisa-lng">
          </div>

          {# Datas #}
          <div id="campo-datas" class="px-6 py-3 rounded-2xl sm:rounded-full hover:bg-gray-50 transition cursor-pointer flex-shrink-0" style="min-width:280px; position:relative;">
            <label class="block text-xs font-bold text-gray-900 pointer-events-none">{{ 'Datas'|t }}</label>
            <div id="datas-display" class="text-sm text-gray-500 leading-5 select-none pointer-events-none pr-7">{{ 'Adicionar datas'|t }}</div>
            <button id="limpar-datas" type="button"
                    class="hidden items-center justify-center w-5 h-5 rounded-full bg-gray-200 hover:bg-gray-300 transition pointer-events-auto"
                    style="position:absolute; right:10px; top:50%; transform:translateY(-50%);">
              <svg class="w-3 h-3 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"/>
              </svg>
            </button>
            <input type="hidden" id="pesquisa-tipo" value="dia">
            <input type="hidden" id="pesquisa-data-inicio">
            <input type="hidden" id="pesquisa-data-fim">
          </div>

          {# Botão pesquisar #}
          <div class="flex items-center justify-end sm:justify-center px-3 py-3 flex-shrink-0">
            <button type="submit" class="bg-black text-white rounded-full p-3 hover:bg-gray-800 transition-all">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"
                      d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
              </svg>
            </button>
          </div>

        </div>{# fim #pesquisa-bar #}

        {# Painel datas — absolute relativo ao container da barra #}
        <div id="datas-panel" class="datas-panel-hidden">
          <div class="datas-panel-tipos">
            <div id="tipo-tabs"></div>
          </div>
          <div class="datas-sep"></div>
          <div id="datas-cal"></div>
        </div>

      </div>{# fim #pesquisa-bar-container #}
    </form>
  </div>

  {# Conteúdo principal #}
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

    <div id="pesquisa-layout" class="flex gap-6 items-start">
      <div class="flex-1 min-w-0">

        <div id="pesquisa-inicial" class="text-center py-24 text-gray-400">
          <svg class="w-16 h-16 mx-auto mb-4 text-gray-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                  d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
          <p class="text-lg font-medium text-gray-400">{{ 'Encontre a sua garagem ideal'|t }}</p>
          <p class="text-sm mt-1">{{ 'Pesquise por localização e datas'|t }}</p>
        </div>

        <div id="pesquisa-loading" class="hidden text-center py-24">
          <div class="inline-block w-8 h-8 border-4 border-black border-t-transparent rounded-full animate-spin"></div>
        </div>

        <div id="pesquisa-empty" class="hidden text-center py-24 text-gray-400">
          <p class="text-lg font-medium">{{ 'Nenhuma garagem encontrada'|t }}</p>
          <p class="text-sm mt-1">{{ 'Tente outra localização ou datas diferentes.'|t }}</p>
        </div>

        <div id="pesquisa-header" class="hidden items-center justify-between mb-6">
          <p id="pesquisa-count" class="text-sm text-gray-500"></p>
        </div>

        <div id="pesquisa-results" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6"></div>
        <div id="pesquisa-scroll-sentinel" class="h-10"></div>
        <div id="pesquisa-load-more" class="hidden py-6 justify-center">
          <div class="w-6 h-6 border-2 border-gray-300 border-t-gray-800 rounded-full animate-spin"></div>
        </div>
      </div>
      <div id="pesquisa-mapa-wrapper" class="hidden lg:w-[45%] flex-shrink-0" style="position:sticky;top:16px;">
        <div style="position:relative;">
          <div id="pesquisa-map" class="rounded-2xl overflow-hidden shadow-md" style="height:calc(100vh - 180px);"></div>
          <div id="mapa-popup" class="hidden" style="position:absolute;z-index:1000;width:260px;background:#fff;border-radius:16px;box-shadow:0 4px 24px rgba(0,0,0,0.18);overflow:hidden;">
            <button id="mapa-popup-fechar" style="position:absolute;top:8px;right:8px;z-index:1;width:28px;height:28px;border-radius:50%;background:rgba(255,255,255,0.9);border:none;cursor:pointer;display:flex;align-items:center;justify-content:center;">
              <svg style="width:12px;height:12px;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"/>
              </svg>
            </button>
            <a id="mapa-popup-link" href="#">
              <img id="mapa-popup-foto" src="" alt="" style="width:100%;height:160px;object-fit:cover;display:block;">
              <div style="padding:12px;">
                <p id="mapa-popup-titulo" style="font-size:14px;font-weight:600;color:#111827;margin:0 0 2px;"></p>
                <p id="mapa-popup-localidade" style="font-size:12px;color:#9ca3af;margin:0 0 6px;"></p>
                <p id="mapa-popup-preco" style="font-size:13px;font-weight:600;color:#111827;margin:0;"></p>
              </div>
            </a>
          </div>
        </div>
      </div>
    </div>

  </div>
</div>
