{#
/**
* @file
* Theme override for an 'input' #type form element.
*
* Available variables:
* - attributes: A list of HTML attributes for the input element.
* - children: Optional additional rendered elements.
*
* @see template_preprocess_input()
*/
#}

{%
set classes = [
        'text-sm font-bold cursor-pointer transition rounded-full py-2.5 px-6 m-0 w-full sm:w-auto',
        element['#attributes'].name == 'entity_form_steps_previous' ? 'bg-gray-100 text-gray-700 border border-gray-200 hover:bg-gray-200' : 'bg-gray-900 text-white hover:bg-gray-700'
    ]
%}

{% if 'remove_button' in element['#name'] %}
    {%
        set classes = [
            'w-10 h-10 rounded-full text-transparent cursor-pointer bg-black bg-[url("/themes/armazens_theme/images/icons/trash.svg")] bg-no-repeat bg-center bg-auto !mb-1 !ml-4 static'
        ]
    %}
{% endif %}

{% if 'add_more' in element['#name'] %}
    {%
        set classes = [
        'text-sm font-bold cursor-pointer transition rounded-full py-2.5 px-6 m-0 w-full sm:w-auto bg-gray-900 text-white hover:bg-gray-700'
        ]
    %}
{% endif %}

<input{{ attributes.removeClass(['button', 'button--primary', 'button--secondary', 'button--danger', 'js-form-submit', 'form-submit']).addClass(classes) }}/>{{ children }}
