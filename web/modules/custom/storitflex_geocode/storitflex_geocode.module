<?php

use Drupal\node\NodeInterface;

/**
 * Executa geocodificação antes de guardar um armazém.
 * Usa entity_presave para não precisar de $node->save() recursivo.
 */
function storitflex_geocode_entity_presave(\Drupal\Core\Entity\EntityInterface $entity) {
  if (!$entity instanceof NodeInterface || $entity->bundle() !== 'armazem') {
    return;
  }

  if (!$entity->hasField('field_localidade') || !$entity->hasField('field_geo_coordenadas')) {
    return;
  }

  if ($entity->get('field_localidade')->isEmpty()) {
    return;
  }

  $address = $entity->get('field_localidade')->first();
  $countries = \Drupal::service('country_manager')->getList();
  $country_name = (string) ($countries[$address->country_code] ?? $address->country_code);

  $postal_code    = trim($address->postal_code ?? '');
  $locality       = trim($address->locality ?? '');
  $administrative = trim($address->administrative_area ?? '');

  if (empty($postal_code)) {
    return;
  }

  // Nominatim não reconhece o formato PT "XXXX-XXX" — usa só os primeiros 4 dígitos.
  $postal_short = explode('-', $postal_code)[0];

  $parts = array_filter([$postal_short, $locality, $administrative, $country_name]);
  $morada = implode(', ', $parts);

  try {
    $geocoder = \Drupal::service('geocoder');
    $result = $geocoder->geocode($morada, ['nominatim']);

    if ($result && $result->first() && $result->first()->getCoordinates()) {
      $coordinates = $result->first()->getCoordinates();
      $lat = $coordinates->getLatitude();
      $lng = $coordinates->getLongitude();

      // Se outro nó já tiver as mesmas coordenadas base, aplica offset pelo nid.
      $wkt_base = 'POINT(' . number_format($lng, 6, '.', '') . ' ' . number_format($lat, 6, '.', '') . ')';
      $duplicate = \Drupal::database()
        ->select('node__field_geo_coordenadas', 'g')
        ->condition('g.field_geo_coordenadas_value', $wkt_base)
        ->condition('g.entity_id', (int) $entity->id(), '<>')
        ->countQuery()->execute()->fetchField();

      if ($duplicate > 0) {
        $nid    = (int) $entity->id() ?: 1;
        $angle  = 2 * M_PI * ($nid % 360) / 360;
        $radius = 0.005; // ~500m
        $lat += cos($angle) * $radius;
        $lng += sin($angle) * $radius;
      }

      $wkt = 'POINT(' . number_format($lng, 6, '.', '') . ' ' . number_format($lat, 6, '.', '') . ')';
      $entity->set('field_geo_coordenadas', ['value' => $wkt]);
    }
  }
  catch (\Throwable $e) {
    \Drupal::logger('storitflex_geocode')->error('Geocode failed for "@title": @msg', [
      '@title' => $entity->label(),
      '@msg'   => $e->getMessage(),
    ]);
  }
}
