{#
/**
 * @file
 * Grid de fotos estilo Airbnb para garagens.
 */
#}
{% set total = items|length %}

<div class="foto-grid relative overflow-hidden rounded-2xl mb-8 h-[300px] sm:h-[380px] lg:h-[480px]">

  {% if total == 1 %}
    {# ── 1 foto: full width ── #}
    <div class="foto-item w-full h-full cursor-pointer" onclick="abrirFotoModal(0)">
      {{ items[0].content }}
    </div>

  {% elseif total == 2 %}
    <div class="h-full sm:grid sm:grid-cols-2 sm:gap-2">
      <div class="foto-item overflow-hidden cursor-pointer h-full" onclick="abrirFotoModal(0)">
        {{ items[0].content }}
      </div>
      <div class="foto-item overflow-hidden cursor-pointer h-full hidden sm:block" onclick="abrirFotoModal(1)">
        {{ items[1].content }}
      </div>
    </div>

  {% elseif total == 3 %}
    <div class="h-full sm:grid sm:grid-cols-2 sm:gap-2">
      <div class="foto-item overflow-hidden cursor-pointer h-full" onclick="abrirFotoModal(0)">
        {{ items[0].content }}
      </div>
      <div class="hidden sm:grid grid-rows-2 gap-2 min-h-0 h-full">
        <div class="foto-item overflow-hidden cursor-pointer min-h-0" onclick="abrirFotoModal(1)">
          {{ items[1].content }}
        </div>
        <div class="foto-item overflow-hidden cursor-pointer min-h-0" onclick="abrirFotoModal(2)">
          {{ items[2].content }}
        </div>
      </div>
    </div>

  {% else %}
    <div class="h-full sm:grid sm:grid-cols-2 sm:gap-2">
      <div class="foto-item overflow-hidden cursor-pointer h-full" onclick="abrirFotoModal(0)">
        {{ items[0].content }}
      </div>
      <div class="hidden sm:grid grid-cols-2 grid-rows-2 gap-2 min-h-0 h-full">
        {% for i in 1..3 %}
          {% if items[i] is defined %}
            <div class="foto-item overflow-hidden cursor-pointer min-h-0" onclick="abrirFotoModal({{ i }})">
              {{ items[i].content }}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  {% endif %}

  {# Botão "Ver todas" #}
  {% if total > 0 %}
    <button type="button" onclick="abrirFotoModal(0)"
            class="absolute bottom-4 right-4 bg-white text-gray-900 text-sm font-semibold px-4 py-2 rounded-xl border border-gray-300 hover:bg-gray-50 transition shadow-sm flex items-center gap-2">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M4 6h16M4 10h16M4 14h16M4 18h16"/>
      </svg>
      {{ 'Ver todas as fotos'|t }}
    </button>
  {% endif %}

</div>

{# ── Modal lightbox ── #}
<div id="foto-lightbox" style="display:none;position:fixed;inset:0;z-index:9999;background:rgba(0,0,0,0.92);align-items:center;justify-content:center;padding:16px;">
  <button onclick="fecharFotoModal()"
          style="position:absolute;top:16px;right:16px;background:none;border:none;cursor:pointer;color:#fff;line-height:1;">
    <svg style="width:32px;height:32px;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
    </svg>
  </button>
  <div style="max-width:900px;width:100%;position:relative;">
    <div id="foto-lightbox-img" style="border-radius:16px;overflow:hidden;"></div>
    <p id="foto-lightbox-count" style="text-align:center;color:#9ca3af;font-size:14px;margin-top:12px;"></p>
    {% if total > 1 %}
      <button onclick="navegarFoto(-1)"
              style="position:absolute;left:8px;top:50%;transform:translateY(-50%);background:rgba(255,255,255,0.15);border:none;border-radius:50%;width:40px;height:40px;cursor:pointer;color:#fff;display:flex;align-items:center;justify-content:center;">
        <svg style="width:20px;height:20px;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
      </button>
      <button onclick="navegarFoto(1)"
              style="position:absolute;right:8px;top:50%;transform:translateY(-50%);background:rgba(255,255,255,0.15);border:none;border-radius:50%;width:40px;height:40px;cursor:pointer;color:#fff;display:flex;align-items:center;justify-content:center;">
        <svg style="width:20px;height:20px;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
      </button>
    {% endif %}
  </div>
</div>

{# ── Dados das fotos para JS ── #}
<div id="foto-data" style="display:none;">
  {% for i in 0..(total - 1) %}
    <div class="foto-src">{{ items[i].content }}</div>
  {% endfor %}
</div>

<script>
(function () {
  var lightbox = document.getElementById('foto-lightbox');
  var imgEl    = document.getElementById('foto-lightbox-img');
  var countEl  = document.getElementById('foto-lightbox-count');
  var total    = {{ total }};
  var current  = 0;

  // Adicionar onclick a cada foto
  document.querySelectorAll('.foto-item').forEach(function (el, idx) {
    el.addEventListener('click', function () { abrirFotoModal(idx); });
  });

  window.abrirFotoModal = function (idx) {
    current = idx;
    renderFoto();
    lightbox.style.display = 'flex';
    document.body.style.overflow = 'hidden';
  };

  window.fecharFotoModal = function () {
    lightbox.style.display = 'none';
    document.body.style.overflow = '';
  };

  window.navegarFoto = function (dir) {
    current = (current + dir + total) % total;
    renderFoto();
  };

  function renderFoto() {
    var src = document.querySelectorAll('#foto-data .foto-src')[current];
    imgEl.innerHTML = src ? src.innerHTML : '';
    var img = imgEl.querySelector('img');
    if (img) { img.style.width = '100%'; img.style.height = 'auto'; img.style.display = 'block'; }
    if (countEl) countEl.textContent = total > 1 ? (current + 1) + ' / ' + total : '';
  }

  // Fechar ao clicar fora
  lightbox.addEventListener('click', function (e) {
    if (e.target === lightbox) fecharFotoModal();
  });

  // Teclado
  document.addEventListener('keydown', function (e) {
    if (lightbox.style.display === 'none') return;
    if (e.key === 'Escape') fecharFotoModal();
    if (e.key === 'ArrowLeft') navegarFoto(-1);
    if (e.key === 'ArrowRight') navegarFoto(1);
  });
})();
</script>

<style>
  .foto-item > *,
  .foto-item img,
  .foto-item picture,
  .foto-item .media,
  .foto-item .field__item,
  .foto-item .field { width: 100%; height: 100%; display: block; }
  .foto-item img { object-fit: cover; }
</style>
