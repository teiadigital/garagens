{#
/**
 * @file
 * Default theme implementation for a fieldgroup html element.
 *
 * Available variables:
 * - title: Title of the group.
 * - title_element: Element to wrap the title.
 * - children: The children of the group.
 * - wrapper_element: The html element to use
 * - attributes: A list of HTML attributes for the group wrapper.
 *
 * @see template_preprocess_field_group_html_element()
 *
 * @ingroup themeable
 */
#}

<div class="container px-4">

    <div class="grid grid-cols-12 gap-y-8 py-16 items-center">
        <div class="col-span-full lg:col-span-7 xl:col-span-5">
            {{element.field_pre_title}}
            <div class="mb-5">
                {{element.field_title}}
            </div>
            {{element.field_text}}
        </div>
        <div class="col-span-full lg:col-start-9 lg:col-span-3 xl:col-start-9 xl:col-span-2">
            <div class="field_link">
                {{element.field_link}}
            </div>
            
        </div>
    </div>

</div>
