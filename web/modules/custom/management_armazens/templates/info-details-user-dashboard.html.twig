<div class="grid grid-cols-3 mt-14 gap-4">
    
    {% for item in data %}
    
        <div class="col-span-full lg:col-span-1 flex flex-wrap items-center gap-y-4 bg-white px-4 py-5">
            <div class="flex-1">
                <p class="text-black text-lg">{{item.label}}</p>
                <p class="text-black text-2xl font-bold">{{item.value}}</p>
            </div>
            {{item.icon|raw}}
        </div>
    {% endfor %}
</div>